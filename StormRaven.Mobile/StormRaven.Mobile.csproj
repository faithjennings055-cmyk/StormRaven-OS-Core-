<Project Sdk="Microsoft.Maui.Sdk/8.0.100">

  <!--
    StormRaven.Mobile - Cross-platform .NET 8 MAUI port of the StormRaven kernel
    for iOS and Android (net8.0-ios;net8.0-android).

    Reuses the kernel's portable sources (Contracts, Kernel/DecisionEngine,
    Providers, Storage, ContextBus, Ipc) via StormRaven.Kernel.Portable.
    The Windows ServiceBase wrapper (Core/StormRaven.Kernel/KernelService.cs) is
    replaced by KernelHostedService running on-device alongside remote Bifrost
    gateway synchronization.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0-ios;net8.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>StormRaven.Mobile</RootNamespace>
    <AssemblyName>StormRavenMobile</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>StormRaven OS</ApplicationTitle>
    <ApplicationId>com.stormraven.mobile</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>2.4.0</ApplicationDisplayVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="8.0.100" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StormRaven.Kernel.Portable\StormRaven.Kernel.Portable.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Info.plist" />
  </ItemGroup>

</Project>
