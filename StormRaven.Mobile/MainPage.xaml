<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StormRaven.Mobile.MainPage"
             Title="StormRaven">
    <VerticalStackLayout Padding="30,60" Spacing="12">
        <Label Text="StormRaven Mobile"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center" />
        <Label x:Name="StatusLabel"
               Text="Kernel starting…"
               FontSize="16"
               HorizontalOptions="Center" />
        <Button Text="Check kernel"
                Clicked="OnCheckKernel" />
    </VerticalStackLayout>
</ContentPage>
