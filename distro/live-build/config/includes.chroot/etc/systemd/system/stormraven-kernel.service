[Unit]
Description=StormRaven OS Kernel + Bifrost Gateway (Ubuntu 24.04 Noble)
Documentation=https://github.com/faithjennings055-cmyk/StormRaven-OS-Core-
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stormraven
ExecStartPre=/usr/bin/install -d -m 0755 /var/lib/stormraven
ExecStart=/usr/bin/python3 /usr/local/bin/stormraven-local-gateway
Environment=STORMRAVEN_DB=/var/lib/stormraven/kernel.db
Environment=STORMRAVEN_GATEWAY_PORT=8787
Environment=STORMRAVEN_UI_PORT=3000
Environment=STORMRAVEN_WEBAPP_DIR=/opt/stormraven/webapp
Environment=STORMRAVEN_PYTHON_DIR=/opt/stormraven/python
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target graphical.target
