#!/usr/bin/env bash
# =============================================================================
# StormRaven OS — Ethereal Void UI Window Launcher (v3.9.0)
# =============================================================================
set +e

UI_PORT="${STORMRAVEN_UI_PORT:-3887}"

if ! ss -tln 2>/dev/null | grep -q ":${UI_PORT} "; then
  STORMRAVEN_GATEWAY_PORT="${UI_PORT}" STORMRAVEN_UI_PORT=3000 python3 /usr/local/bin/stormraven-local-gateway >/tmp/stormraven-ui-gateway.log 2>&1 &
fi

for _ in $(seq 1 20); do
  if curl -fsS "http://127.0.0.1:${UI_PORT}/health" >/dev/null 2>&1; then
    break
  fi
  sleep 0.25
done

URL="${1:-http://127.0.0.1:${UI_PORT}/}"

export NO_AT_BRIDGE=1
export GDK_BACKEND=x11

if [ -x /usr/local/bin/stormraven-shell-window ]; then
  python3 /usr/local/bin/stormraven-shell-window "${URL}" >/tmp/stormraven-shell-window.log 2>&1 &
  exit 0
fi

for browser in epiphany-browser netsurf-gtk chromium chromium-browser firefox xdg-open; do
  if command -v "${browser}" >/dev/null 2>&1; then
    WEBKIT_DISABLE_COMPOSITING_MODE=1 WEBKIT_DISABLE_DMABUF_RENDERER=1 LIBGL_ALWAYS_SOFTWARE=1 \
      "${browser}" "${URL}" >/tmp/stormraven-browser.log 2>&1 &
    exit 0
  fi
done
