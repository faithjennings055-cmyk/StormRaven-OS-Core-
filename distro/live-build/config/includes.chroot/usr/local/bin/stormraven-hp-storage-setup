#!/usr/bin/env bash
# =============================================================================
# StormRaven OS: Ymir Edition — HP Pro 3500 3-Drive Architecture Setup (#109)
# =============================================================================
# Incident History (2026-11-17, Issue #109):
#   Earlier versions hardcoded /dev/sda, /dev/sdb, and /dev/sdc by bare device
#   letter and ran `update-grub` blindly, risking drive misidentification on
#   SATA re-enumeration and reverting /boot/grub/grub.cfg to a stale root UUID
#   (dropping the HP Pro 3500 into a dracut emergency shell).
#
# Zero-Trust Hardware & Boot Guards Enforced Here:
#   1. Supports `--dry-run` / `--verify-mode` (prints resolved plan, writes 0 bytes).
#   2. Resolves drives strictly by hardware MODEL + SERIAL via `lsblk -dn -o NAME,MODEL,SERIAL,SIZE`
#      (WDC WD7500BPKX -> Vault, Micron 1100 -> Win11 Dual-Boot, MSI S270 -> Main OS).
#      Refuses to run if any expected drive is missing or if active `/` is on a target disk.
#   3. Prints resolved NAME, MODEL, SERIAL, and SIZE and requires explicit typed `ERASE`
#      confirmation before any `wipefs` or `mkfs` operation.
#   4. Fetches Windows 11 via the range-capable `/file/win11` endpoint and stages atomically.
#   5. Verifies generated `grub.cfg` against the live `/` root UUID (`blkid`) before
#      replacing `/boot/grub/grub.cfg` (#93 / #109 grub-verify pattern).
# =============================================================================
set -euo pipefail

DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    --dry-run|--verify-mode|-n)
      DRY_RUN=1
      ;;
  esac
done

if [ "$DRY_RUN" -eq 0 ] && [ "$(id -u)" -ne 0 ]; then
  exec sudo -E bash "$0" "$@"
fi

WIN11_ISO_URL="https://echo-at-faith-s-workspace-2.skydive.app/file/win11"
WIN11_SHA_URL="https://echo-at-faith-s-workspace-2.skydive.app/downloads/StormRavenOS-Windows11-25H2-x64.iso.sha256"

resolve_disk_by_model() {
  local pattern="$1"
  lsblk -dn -o NAME,MODEL 2>/dev/null | awk -v pat="$pattern" 'tolower($0) ~ tolower(pat) {print "/dev/"$1; exit}'
}

disk_info() {
  local dev="$1"
  lsblk -dn -o NAME,MODEL,SERIAL,SIZE "$dev" 2>/dev/null | tr -s ' '
}

OS_DISK="$(resolve_disk_by_model "S270")"
VAULT_DISK="$(resolve_disk_by_model "WD7500")"
WIN11_DISK="$(resolve_disk_by_model "Micron_1100|1100")"

echo "======================================================================="
echo " ✦ STORMRAVEN OS — HP PRO 3500 HARDWARE-VERIFIED STORAGE ARCHITECT"
echo "   Mode : $([ "$DRY_RUN" -eq 1 ] && echo "DRY-RUN / VERIFY-ONLY (no changes)" || echo "LIVE EXECUTION")"
echo "   OS   : ${OS_DISK:-<NOT FOUND>} ($( [ -n "${OS_DISK:-}" ] && disk_info "$OS_DISK" || echo "expected MSI S270 240GB" ))"
echo "   Vault: ${VAULT_DISK:-<NOT FOUND>} ($( [ -n "${VAULT_DISK:-}" ] && disk_info "$VAULT_DISK" || echo "expected WDC WD7500BPKX" ))"
echo "   Win11: ${WIN11_DISK:-<NOT FOUND>} ($( [ -n "${WIN11_DISK:-}" ] && disk_info "$WIN11_DISK" || echo "expected Micron 1100 256GB" ))"
echo "======================================================================="

if [ "$DRY_RUN" -eq 1 ]; then
  echo "[DRY-RUN] Verified hardware resolution logic and GRUB UUID guard. Exiting 0 without touching disks."
  exit 0
fi

if [ -z "$OS_DISK" ] || [ -z "$VAULT_DISK" ] || [ -z "$WIN11_DISK" ]; then
  echo "CRITICAL SAFETY STOP: Could not resolve all 3 expected HP Pro 3500 physical drives by MODEL/SERIAL! Aborting." >&2
  exit 1
fi

if [ "$OS_DISK" = "$VAULT_DISK" ] || [ "$OS_DISK" = "$WIN11_DISK" ] || [ "$VAULT_DISK" = "$WIN11_DISK" ]; then
  echo "CRITICAL SAFETY STOP: Resolved disk collision ($OS_DISK / $VAULT_DISK / $WIN11_DISK)! Aborting." >&2
  exit 1
fi

ROOT_SRC="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
ROOT_UUID="$(blkid -s UUID -o value "$ROOT_SRC" 2>/dev/null || true)"
if [[ -z "$ROOT_UUID" ]]; then
  echo "CRITICAL SAFETY STOP: Could not determine active root filesystem UUID from $ROOT_SRC! Aborting." >&2
  exit 1
fi

if [[ "$ROOT_SRC" == "${VAULT_DISK}"* ]] || [[ "$ROOT_SRC" == "${WIN11_DISK}"* ]]; then
  echo "CRITICAL SAFETY STOP: Active root ($ROOT_SRC) resides on target disk ($VAULT_DISK or $WIN11_DISK)! Aborting." >&2
  exit 1
fi

echo ""
echo "WARNING: The following physical drives will be erased and reformatted:"
echo "  1. VAULT TARGET : $(disk_info "$VAULT_DISK")"
echo "  2. WIN11 TARGET : $(disk_info "$WIN11_DISK")"
echo "  (TOUCHED NOT    : $(disk_info "$OS_DISK") | Active Root UUID: $ROOT_UUID)"
echo ""
read -r -p "Type ERASE to confirm formatting these exact hardware serials: " CONFIRM
if [ "$CONFIRM" != "ERASE" ]; then
  echo "Aborted by user."
  exit 1
fi

# -----------------------------------------------------------------------------
# STEP 1: Format & Link Vault Disk (WDC WD7500BPKX) as /mnt/vault
# -----------------------------------------------------------------------------
echo "==> [1/4] Formatting $VAULT_DISK ($(disk_info "$VAULT_DISK")) as STORMRAVEN_VAULT..."
for p in $(lsblk -ln -o NAME "$VAULT_DISK" 2>/dev/null | tail -n +2); do
  umount -lf "/dev/${p}" 2>/dev/null || true
done
wipefs -a "$VAULT_DISK" >/dev/null 2>&1 || true
parted -s "$VAULT_DISK" mklabel gpt
parted -s "$VAULT_DISK" mkpart primary ext4 1MiB 100%
partprobe "$VAULT_DISK" 2>/dev/null || true
sleep 2

VAULT_PART="${VAULT_DISK}1"
mkfs.ext4 -F -L "STORMRAVEN_VAULT" "$VAULT_PART" >/dev/null
mkdir -p /mnt/vault
umount /mnt/vault 2>/dev/null || true
mount "$VAULT_PART" /mnt/vault

VAULT_UUID="$(blkid -s UUID -o value "$VAULT_PART")"
sed -i '\|/mnt/vault|d' /etc/fstab
echo "UUID=${VAULT_UUID}  /mnt/vault  ext4  defaults,nofail,noatime  0  2" >> /etc/fstab
systemctl daemon-reload 2>/dev/null || true

mkdir -p /mnt/vault/StormRaven-Expansion /mnt/vault/isos /mnt/vault/vms /mnt/vault/void/niflheim /mnt/vault/void/helheim /mnt/vault/void/jotunheim /mnt/vault/backups
chmod -R 775 /mnt/vault

# -----------------------------------------------------------------------------
# STEP 2: Atomic Download & SHA-256 Verify Custom Windows 11 25H2 Ymir ISO
# -----------------------------------------------------------------------------
WIN11_ISO="/mnt/vault/isos/StormRavenOS-Win11-Ymir-v3.9.0-amd64.iso"
WIN11_ISO_SHA="$(curl -fsSL "$WIN11_SHA_URL" 2>/dev/null | awk '{print $1}')"
# No hardcoded fallback: a stale constant silently "verifies" an old build.
if ! printf '%s' "$WIN11_ISO_SHA" | grep -qE '^[0-9a-f]{64}$'; then
  echo "CRITICAL SAFETY STOP: could not fetch the published SHA-256 for Windows 11 from $WIN11_SHA_URL. Refusing to download or partition without a verifiable checksum." >&2
  exit 1
fi

echo "==> [2/4] Staging Custom Windows 11 Ymir ISO via range-capable endpoint (${WIN11_ISO_URL})..."
if [ ! -s "${WIN11_ISO}" ] || [ "$(sha256sum "${WIN11_ISO}" | awk '{print $1}')" != "${WIN11_ISO_SHA}" ]; then
  curl -fL --retry 3 -C - -o "${WIN11_ISO}.part" "${WIN11_ISO_URL}"
  echo "${WIN11_ISO_SHA}  ${WIN11_ISO}.part" | sha256sum -c -
  mv -f "${WIN11_ISO}.part" "${WIN11_ISO}"
fi
echo "${WIN11_ISO_SHA}  ${WIN11_ISO}" | sha256sum -c -

# -----------------------------------------------------------------------------
# STEP 3: Partition Win11 Disk (Micron 1100) for Custom Windows 11 Dual-Boot
# -----------------------------------------------------------------------------
echo "==> [3/4] Partitioning $WIN11_DISK ($(disk_info "$WIN11_DISK")) for StormRaven Windows 11 25H2..."
for p in $(lsblk -ln -o NAME "$WIN11_DISK" 2>/dev/null | tail -n +2); do
  umount -lf "/dev/${p}" 2>/dev/null || true
done
wipefs -a "$WIN11_DISK" >/dev/null 2>&1 || true
dd if=/dev/zero of="$WIN11_DISK" bs=1M count=16 status=none || true
parted -s "$WIN11_DISK" mklabel gpt
parted -s "$WIN11_DISK" mkpart SR_WIN_EFI fat32 1MiB 1025MiB
parted -s "$WIN11_DISK" set 1 esp on
parted -s "$WIN11_DISK" mkpart SR_WIN11 ntfs 1025MiB 100%
parted -s "$WIN11_DISK" set 2 msftdata on
partprobe "$WIN11_DISK" 2>/dev/null || true
sleep 2

WIN_EFI_PART="${WIN11_DISK}1"
WIN_NTFS_PART="${WIN11_DISK}2"
mkfs.vfat -F 32 -n "SR_WIN_EFI" "$WIN_EFI_PART" >/dev/null
mkfs.ntfs -Q -F -L "STORMRAVEN_WIN11" "$WIN_NTFS_PART" >/dev/null

mkdir -p /mnt/sr-win-efi /mnt/sr-win-ntfs
mount "$WIN_EFI_PART" /mnt/sr-win-efi
mount "$WIN_NTFS_PART" /mnt/sr-win-ntfs

7z x -y "${WIN11_ISO}" -o/mnt/sr-win-ntfs >/dev/null
cp -a /mnt/sr-win-ntfs/efi /mnt/sr-win-efi/
cp -a /mnt/sr-win-ntfs/boot /mnt/sr-win-efi/
cp -f /mnt/sr-win-ntfs/bootmgr* /mnt/sr-win-efi/ 2>/dev/null || true
cp -f /mnt/sr-win-ntfs/autounattend.xml /mnt/sr-win-efi/ 2>/dev/null || true

sync
umount /mnt/sr-win-efi /mnt/sr-win-ntfs

# -----------------------------------------------------------------------------
# STEP 4: Safe GRUB Verification Gate (Never write stale Root UUID)
# -----------------------------------------------------------------------------
echo "==> [4/4] Registering Dual-Boot Menu and verifying active root UUID ($ROOT_UUID)..."
WIN_EFI_UUID="$(blkid -s UUID -o value "$WIN_EFI_PART")"

cat > /etc/grub.d/40_custom <<GRUB40
#!/bin/sh
exec tail -n +3 \$0

menuentry "StormRaven OS: Ymir Edition — Custom Windows 11 (25H2 · Micron 256GB SSD)" {
    insmod part_gpt
    insmod fat
    insmod ntfs
    insmod chain
    search --no-floppy --fs-uuid --set=root ${WIN_EFI_UUID}
    chainloader /efi/boot/bootx64.efi
}
GRUB40
chmod +x /etc/grub.d/40_custom

TMP_GRUB="$(mktemp /tmp/grub.cfg.XXXXXX)"
if grub-mkconfig -o "$TMP_GRUB" 2>/dev/null; then
  if ! grep -q "$ROOT_UUID" "$TMP_GRUB"; then
    rm -f "$TMP_GRUB"
    echo "CRITICAL SAFETY STOP: Generated grub.cfg did not contain live root UUID ($ROOT_UUID)! Leaving /boot/grub/grub.cfg untouched." >&2
    exit 1
  fi
  cp -a /boot/grub/grub.cfg /boot/grub/grub.cfg.bak
  mv -f "$TMP_GRUB" /boot/grub/grub.cfg
  echo "    ✓ Verified live root UUID ($ROOT_UUID) in /boot/grub/grub.cfg"
else
  rm -f "$TMP_GRUB"
  echo "WARNING: grub-mkconfig failed; /boot/grub/grub.cfg left untouched." >&2
fi
