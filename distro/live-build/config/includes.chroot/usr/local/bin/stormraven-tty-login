#!/usr/bin/env python3
"""StormRaven OS v3.9.3 PAM-Free Direct TTY Session Launcher (/bin/login & agetty -l)."""
import os
import pwd
import sys

def resolve_user(args):
    candidates = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("-h", "-H"):
            i += 2
            continue
        if a == "--":
            candidates.extend(args[i+1:])
            break
        if a.startswith("-"):
            i += 1
            continue
        candidates.append(a)
        i += 1

    for c in candidates:
        c_clean = c.strip().lstrip("\\")
        if c_clean in ("ubuntu", "stormraven", "root", "user"):
            return c_clean
        try:
            pwd.getpwnam(c_clean)
            return c_clean
        except KeyError:
            pass

    try:
        tty = os.ttyname(0)
    except Exception:
        tty = ""
    if tty.endswith("tty1") or tty.endswith("ttyS0"):
        return "ubuntu"
    return "stormraven"

def main():
    username = resolve_user(sys.argv[1:])
    try:
        pw = pwd.getpwnam(username)
    except KeyError:
        pw = pwd.getpwnam("ubuntu")

    uid, gid, home, shell = pw.pw_uid, pw.pw_gid, pw.pw_dir, pw.pw_shell or "/bin/bash"
    runtime_dir = f"/run/user/{uid}"
    try:
        os.makedirs(runtime_dir, mode=0o700, exist_ok=True)
        os.chown(runtime_dir, uid, gid)
    except Exception:
        pass

    try:
        tty = os.ttyname(0)
        os.chown(tty, uid, gid)
        os.chmod(tty, 0o620)
    except Exception:
        pass

    try:
        os.initgroups(pw.pw_name, gid)
        os.setgid(gid)
        os.setuid(uid)
    except Exception:
        pass

    os.environ["USER"] = pw.pw_name
    os.environ["LOGNAME"] = pw.pw_name
    os.environ["HOME"] = home
    os.environ["SHELL"] = shell
    os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    os.environ["XDG_RUNTIME_DIR"] = runtime_dir
    os.environ.setdefault("TERM", "linux")

    try:
        os.chdir(home)
    except Exception:
        os.chdir("/")

    os.execv(shell, [f"-{os.path.basename(shell)}"])

if __name__ == "__main__":
    main()
