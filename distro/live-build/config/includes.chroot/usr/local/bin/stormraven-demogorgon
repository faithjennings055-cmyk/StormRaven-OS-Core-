#!/usr/bin/env python3
"""StormRaven OS — Demogorgon Tarpit & Lynn Honeycomb Defense CLI.

Supports:
  stormraven-demogorgon status
  stormraven-demogorgon awaken
  stormraven-demogorgon banish
  stormraven-demogorgon probe [src_ip]
  stormraven-demogorgon daemon
"""
import json
import os
import signal
import sys
import time

for p in (
    "/opt/stormraven/python",
    "/home/user/.self/stormraven-runtime/python",
    os.path.join(os.path.dirname(__file__), "..", "StormRaven.Python"),
):
    if os.path.isdir(p) and p not in sys.path:
        sys.path.insert(0, p)

from demogorgon import get_demogorgon  # noqa: E402


def main() -> int:
    cmd = (sys.argv[1] if len(sys.argv) > 1 else "status").strip().lower()
    d = get_demogorgon()
    if cmd == "daemon":
        msg = d.awaken()
        print(json.dumps({"ok": True, "mode": "daemon", "message": msg, **d.status_report()}), flush=True)
        stop = False

        def _sig(_signum, _frame):
            nonlocal stop
            stop = True

        signal.signal(signal.SIGTERM, _sig)
        signal.signal(signal.SIGINT, _sig)
        while not stop and d.is_active:
            time.sleep(1.0)
        d.banish()
        return 0
    if cmd == "awaken":
        msg = d.awaken()
        print(json.dumps({"ok": True, "action": "awaken", "message": msg, **d.status_report()}))
        return 0
    if cmd == "banish":
        msg = d.banish()
        print(json.dumps({"ok": True, "action": "banish", "message": msg, **d.status_report()}))
        return 0
    if cmd in ("probe", "simulate-probe", "test-probe"):
        ip = sys.argv[2] if len(sys.argv) > 2 else "198.51.100.42"
        rec = d.simulate_probe(src_ip=ip)
        print(json.dumps({"ok": True, "action": "probe", "incident": rec, **d.status_report()}))
        return 0
    print(json.dumps({"ok": True, "action": "status", **d.status_report()}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
