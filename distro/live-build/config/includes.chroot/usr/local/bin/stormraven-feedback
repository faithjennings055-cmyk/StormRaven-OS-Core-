#!/usr/bin/env bash
# =============================================================================
# StormRaven OS — Worldwide 1,000-Slot Beta Telemetry & Feedback CLI
# =============================================================================
# Usage:
#   stormraven feedback "Summary of bug or working hardware" ["Optional details"]
#   stormraven beta-status
# =============================================================================
set +e

BETA_API="${STORMRAVEN_BETA_API:-https://echo-at-faith-s-workspace-2.skydive.app}"
CMD="${1:-}"

if [ "${CMD}" = "status" ] || [ "${CMD}" = "--status" ]; then
  curl -fsSL "${BETA_API}/api/beta/status"
  echo ""
  exit 0
fi

SUMMARY="${1:-}"
DETAILS="${2:-}"

if [ -z "${SUMMARY}" ]; then
  echo "=== StormRaven OS Worldwide 1,000-Slot Beta Feedback ==="
  read -r -p "One-line summary (what worked or what needs fixing): " SUMMARY
  [ -z "${SUMMARY}" ] && { echo "Aborted (empty summary)."; exit 1; }
  read -r -p "Details / logs (optional): " DETAILS
fi

HW_INFO="$(uname -srm 2>/dev/null || echo 'StormRaven-Host')"
if command -v lscpu >/dev/null 2>&1; then
  CPU_MODEL="$(lscpu 2>/dev/null | awk -F: '/Model name/ {gsub(/^[ \t]+/,"",$2); print $2; exit}')"
  [ -n "${CPU_MODEL}" ] && HW_INFO="${HW_INFO} · ${CPU_MODEL}"
fi

PAYLOAD="$(python3 -c 'import json,sys; print(json.dumps({"edition":"ubuntu-26.04","severity":"normal","hardwareInfo":sys.argv[1],"summary":sys.argv[2],"details":sys.argv[3]}))' "${HW_INFO}" "${SUMMARY}" "${DETAILS}")"

curl -fsSL -X POST "${BETA_API}/api/beta/feedback" \
  -H "Content-Type: application/json" \
  -d "${PAYLOAD}"
echo ""
