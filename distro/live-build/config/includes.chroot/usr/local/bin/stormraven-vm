#!/usr/bin/env bash
# =============================================================================
# StormRaven OS — Built-in KVM/QEMU, Libvirt & Container-Native Windows (#25 / #98)
# =============================================================================
set -euo pipefail

POOL_DIR="/var/lib/libvirt/images"
CLOUD_URL="${STORMRAVEN_GATEWAY_URL:-https://01a11428-2aab-7e12-9d89-3543f658a191.skydive.app}"

usage() {
  cat <<EOF
Usage: stormraven-vm <command> [args]

Commands:
  status                           Show KVM/QEMU hypervisor & nested-virt status (JSON)
  win11 [win11-iso-path]           Launch Windows 11 test VM with TPM 2.0 + preloaded StormRaven Win11 drive
  dockur-status                    Show Container-Native StormRaven Windows v4.0 (dockur/windows) status (JSON) (#98)
  dockur-up [--iso <path>]         Verify base ISO SHA-256 and start Container-Native StormRaven Windows v4.0 (#98)
  dockur-down                      Stop Container-Native StormRaven Windows v4.0 container (#98)
  init-pool                        Initialize default libvirt storage pool (${POOL_DIR})
  snapshot <vm-name> <snap-name>   Create live/offline qcow2 snapshot
  restore <vm-name> <snap-name>    Revert VM to snapshot
  usb-attach <vm-name> <vid:pid>   Attach host USB device via passthrough
EOF
}

verify_iso_sidecar() {
  local iso_file="$1"
  local sha_file="${iso_file}.sha256"
  if [ ! -f "${sha_file}" ]; then
    echo "ERROR: Missing SHA-256 sidecar (${sha_file}) for ${iso_file} — refusing unverified ISO (#98)." >&2
    return 1
  fi
  local expected actual
  expected="$(awk '{print $1}' "${sha_file}" | head -n 1 | tr 'A-F' 'a-f')"
  actual="$(sha256sum "${iso_file}" | awk '{print $1}' | tr 'A-F' 'a-f')"
  if [ "${expected}" != "${actual}" ]; then
    echo "ERROR: SHA-256 mismatch for ${iso_file} (expected ${expected}, got ${actual})." >&2
    return 1
  fi
  return 0
}

cmd="${1:-status}"
case "${cmd}" in
  win11)
    shift || true
    if [ -x /usr/local/bin/vm-win11.sh ]; then
      exec sudo /usr/local/bin/vm-win11.sh "$@"
    else
      tmp_vm="$(mktemp /tmp/vm-win11.XXXXXX.sh)"
      curl -fsSL "${CLOUD_URL}/vm-win11.sh" -o "${tmp_vm}"
      curl -fsSL "${CLOUD_URL}/vm-win11.sh.sha256" -o "${tmp_vm}.sha256"
      expected_sha="$(awk '{print $1}' "${tmp_vm}.sha256" | head -n 1)"
      echo "${expected_sha}  ${tmp_vm}" | sha256sum -c - >/dev/null
      chmod 0755 "${tmp_vm}"
      exec sudo "${tmp_vm}" "$@"
    fi
    ;;
  dockur|dockur-status)
    kvm_loaded="false"
    [ -e /dev/kvm ] && kvm_loaded="true"
    runtime="none"
    if command -v docker >/dev/null 2>&1; then
      runtime="docker"
    elif command -v podman >/dev/null 2>&1; then
      runtime="podman"
    fi
    running="false"
    if [ "${runtime}" != "none" ]; then
      if "${runtime}" ps --format '{{.Names}}' 2>/dev/null | grep -q "^StormRaven-Win11-Ymir-Container$"; then
        running="true"
      fi
    fi
    cat <<JSON
{
  "distribution": "StormRaven OS: Container-Native Windows v4.0 (dockur/windows base)",
  "issue": "#98",
  "containerName": "StormRaven-Win11-Ymir-Container",
  "image": "dockurr/windows:latest",
  "containerRuntime": "${runtime}",
  "kvmDevice": ${kvm_loaded},
  "running": ${running},
  "endpoints": {
    "webDisplayNoVnc": "http://127.0.0.1:${STORMRAVEN_DOCKUR_WEB_PORT:-8006}",
    "rdpEndpoint": "127.0.0.1:${STORMRAVEN_DOCKUR_RDP_PORT:-3389}",
    "bifrostHudInsideVm": "http://127.0.0.1:${STORMRAVEN_DOCKUR_HUD_PORT:-3887}",
    "bifrostKernelInsideVm": "http://127.0.0.1:${STORMRAVEN_DOCKUR_KERNEL_PORT:-8787}"
  },
  "checksumVerifiedIsoRequired": true,
  "oemProvisioner": "distro/containers/dockur-windows/oem/install.bat"
}
JSON
    ;;
  dockur-up)
    shift || true
    CUSTOM_ISO=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --iso) CUSTOM_ISO="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    if [ -z "${CUSTOM_ISO}" ]; then
      for cand in "/var/lib/stormraven/iso/StormRavenOS-Win11-Ymir-v3.9.0-amd64.iso" \
                  "${HOME:-/home/user}/Documents/StormRavenOS-Win11-Ymir-v3.9.0-amd64.iso" \
                  "/tmp/iso/StormRavenOS-Win11-Ymir-v3.9.0-amd64.iso"; do
        if [ -f "${cand}" ]; then
          CUSTOM_ISO="${cand}"
          break
        fi
      done
    fi
    ISO_MOUNT_ARGS=()
    if [ -n "${CUSTOM_ISO}" ]; then
      echo "[StormRaven Container-Native Windows] Verifying SHA-256 sidecar for ${CUSTOM_ISO}..."
      verify_iso_sidecar "${CUSTOM_ISO}"
      ISO_MOUNT_ARGS=(-v "${CUSTOM_ISO}:/custom.iso:ro")
    fi
    RUNTIME="docker"
    command -v docker >/dev/null 2>&1 || RUNTIME="podman"
    OEM_DIR="/opt/stormraven/containers/dockur-windows/oem"
    [ -d "${OEM_DIR}" ] || OEM_DIR="$(pwd)/distro/containers/dockur-windows/oem"
    exec "${RUNTIME}" run -d \
      --name StormRaven-Win11-Ymir-Container \
      --device=/dev/kvm \
      --device=/dev/net/tun \
      --cap-add NET_ADMIN \
      -p "127.0.0.1:${STORMRAVEN_DOCKUR_WEB_PORT:-8006}:8006" \
      -p "127.0.0.1:${STORMRAVEN_DOCKUR_RDP_PORT:-3389}:3389/tcp" \
      -p "127.0.0.1:${STORMRAVEN_DOCKUR_RDP_PORT:-3389}:3389/udp" \
      -p "127.0.0.1:${STORMRAVEN_DOCKUR_HUD_PORT:-3887}:3887/tcp" \
      -p "127.0.0.1:${STORMRAVEN_DOCKUR_KERNEL_PORT:-8787}:8787/tcp" \
      -e VERSION="${STORMRAVEN_WIN_VERSION:-11}" \
      -e RAM_SIZE="${STORMRAVEN_WIN_RAM:-4G}" \
      -e CPU_CORES="${STORMRAVEN_WIN_CORES:-4}" \
      -e DISK_SIZE="${STORMRAVEN_WIN_DISK:-64G}" \
      -e USERNAME="stormraven" \
      -v "${OEM_DIR}:/oem:ro" \
      "${ISO_MOUNT_ARGS[@]}" \
      --stop-timeout 120 \
      dockurr/windows:latest
    ;;
  dockur-down)
    RUNTIME="docker"
    command -v docker >/dev/null 2>&1 || RUNTIME="podman"
    "${RUNTIME}" stop -t 120 StormRaven-Win11-Ymir-Container 2>/dev/null || true
    "${RUNTIME}" rm -f StormRaven-Win11-Ymir-Container 2>/dev/null || true
    echo '{"status":"stopped","containerName":"StormRaven-Win11-Ymir-Container"}'
    ;;
  status)
    kvm_loaded="false"
    [ -e /dev/kvm ] && kvm_loaded="true"
    nested="disabled"
    if [ -f /sys/module/kvm_intel/parameters/nested ] && grep -qE "Y|1" /sys/module/kvm_intel/parameters/nested 2>/dev/null; then
      nested="enabled"
    elif [ -f /sys/module/kvm_amd/parameters/nested ] && grep -qE "Y|1" /sys/module/kvm_amd/parameters/nested 2>/dev/null; then
      nested="enabled"
    fi
    vms=0
    if command -v virsh >/dev/null 2>&1; then
      vms="$(virsh list --all --name 2>/dev/null | grep -c . || true)"
    fi
    printf '{"hypervisor":"KVM/QEMU","kvmDevice":%s,"nestedVirt":"%s","defaultPool":"%s","configuredVms":%d}\n' \
      "${kvm_loaded}" "${nested}" "${POOL_DIR}" "${vms}"
    ;;
  init-pool)
    mkdir -p "${POOL_DIR}"
    chmod 0711 "${POOL_DIR}"
    if command -v virsh >/dev/null 2>&1; then
      virsh pool-define-as default dir - - - - "${POOL_DIR}" 2>/dev/null || true
      virsh pool-build default 2>/dev/null || true
      virsh pool-start default 2>/dev/null || true
      virsh pool-autostart default 2>/dev/null || true
    fi
    echo "Default storage pool initialized at ${POOL_DIR}"
    ;;
  snapshot)
    vm="${2:?VM name required}"
    snap="${3:-snap-$(date -u +%Y%m%dT%H%M%SZ)}"
    virsh snapshot-create-as --domain "${vm}" --name "${snap}" --description "StormRaven VM snapshot"
    ;;
  restore)
    vm="${2:?VM name required}"
    snap="${3:?Snapshot name required}"
    virsh snapshot-revert --domain "${vm}" --snapshotname "${snap}"
    ;;
  usb-attach)
    vm="${2:?VM name required}"
    vidpid="${3:?Vendor:Product ID (e.g. 046d:c52b) required}"
    vid="0x${vidpid%%:*}"
    pid="0x${vidpid##*:}"
    tmp_xml="$(mktemp)"
    cat > "${tmp_xml}" <<XML
<hostdev mode='subsystem' type='usb' managed='yes'>
  <source>
    <vendor id='${vid}'/>
    <product id='${pid}'/>
  </source>
</hostdev>
XML
    virsh attach-device "${vm}" "${tmp_xml}" --live --config
    rm -f "${tmp_xml}"
    ;;
  *)
    usage
    exit 1
    ;;
esac
