class StormRavenCommandCenter(Gtk.Window):
    def __init__(self):
        super().__init__(
            title="StormRaven OS: Infinity Protocol v3.9.0 — Windows 11 Edition + Moov AI"
        )
        self.set_default_size(960, 640)
        self.set_position(Gtk.WindowPosition.CENTER)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.get_style_context().add_class("void-bg")
        self.add(root)

        # Top Header Bar
        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        hdr.get_style_context().add_class("header-bar")
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_title = Gtk.Label(
            label="🪟 STORMRAVEN OS · INFINITY PROTOCOL v3.9.0 — WINDOWS 11 EDITION + MOOV AI"
        )
        lbl_title.set_xalign(0)
        lbl_title.get_style_context().add_class("title-lg")
        self.lbl_sub = Gtk.Label(
            label="Bifrost Gateway (:8787) · Windows 11 Edition UI (:3887) · Moov AI NACHA ACH & X9.37 Check Deposit ACTIVE"
        )
        self.lbl_sub.set_xalign(0)
        self.lbl_sub.get_style_context().add_class("subtitle")
        title_box.pack_start(lbl_title, False, False, 0)
        title_box.pack_start(self.lbl_sub, False, False, 0)
        hdr.pack_start(title_box, True, True, 0)

        self.lbl_top_bal = Gtk.Label(label="● MOOV WALLET: $12,450.00 USD")
        self.lbl_top_bal.get_style_context().add_class("status-ok")
        hdr.pack_end(self.lbl_top_bal, False, False, 8)
        root.pack_start(hdr, False, False, 0)

        # Welcome Banner
        banner_wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        banner_wrap.set_margin_top(10)
        banner_wrap.set_margin_start(14)
        banner_wrap.set_margin_end(14)
        banner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        banner.get_style_context().add_class("banner-box")

        b_txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        b_h = Gtk.Label()
        b_h.set_xalign(0)
        b_h.set_markup(
            "<b>StormRaven OS v3.9.0 — Windows 11 Edition + Moov AI (Installed on HP Pro 3500)</b>"
        )
        b_p = Gtk.Label(
            label="Moov AI Same-Day ACH (.ach NACHA) · X9.37 Check 21 Mobile Check Deposit (.x937 ICL) · 37 Native Apps · Ymir Cryo-Glass UI"
        )
        b_p.set_xalign(0)
        b_p.get_style_context().add_class("subtitle")
        b_txt.pack_start(b_h, False, False, 0)
        b_txt.pack_start(b_p, False, False, 0)
        banner.pack_start(b_txt, True, True, 0)

        btn_moov_tab = Gtk.Button(label="🏦 Open Moov AI Banking & Check Deposit")
        btn_moov_tab.get_style_context().add_class("cta-btn")
        btn_moov_tab.connect("clicked", lambda *_: self.nb.set_current_page(1))
        banner.pack_end(btn_moov_tab, False, False, 0)

        btn_web = Gtk.Button(label="🪟 Open Win11 Web OS (:3887)")
        btn_web.get_style_context().add_class("sec-btn")
        btn_web.connect(
            "clicked",
            lambda *_: self.spawn_cmd(
                "google-chrome --no-sandbox --app=http://127.0.0.1:3887/?os=win11 2>/dev/null || netsurf-gtk http://127.0.0.1:3887/"
            ),
        )
        banner.pack_end(btn_web, False, False, 0)

        banner_wrap.pack_start(banner, False, False, 0)
        root.pack_start(banner_wrap, False, False, 0)

        # Notebook Tabs
        self.nb = Gtk.Notebook()
        self.nb.set_margin_top(10)
        self.nb.set_margin_start(14)
        self.nb.set_margin_end(14)
        self.nb.set_margin_bottom(12)
        root.pack_start(self.nb, True, True, 0)

        # =====================================================================
        # TAB 1: Windows 11 Edition Applications & System Suite
        # =====================================================================
        grid_scroll = Gtk.ScrolledWindow()
        grid_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        grid_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        grid_vbox.set_margin_top(12)
        grid_vbox.set_margin_bottom(12)
        grid_vbox.set_margin_start(12)
        grid_vbox.set_margin_end(12)

        grid = Gtk.Grid()
        grid.set_column_spacing(10)
        grid.set_row_spacing(10)
        grid.set_column_homogeneous(True)

        apps = [
            ("🏦 Moov AI Banking & Check Deposit", "__TAB__:1"),
            ("📸 Instant $500 Check Deposit", "__ACTION__:moov_check"),
            ("⚡ Instant $250 ACH Transfer", "__ACTION__:moov_ach"),
            ("🔄 Check & Install Updates", "__ACTION__:update"),
            ("🔀 Switch Ubuntu / Win11 Layout", "__ACTION__:layout_toggle"),
            ("🪟 Win11 Cryo-Glass Web OS", "google-chrome --no-sandbox --app=http://127.0.0.1:3887/?os=win11 2>/dev/null || netsurf-gtk http://127.0.0.1:3887/"),
            ("🌐 Moov AI Web Portal (:3887/moov)", "google-chrome --no-sandbox --app=http://127.0.0.1:3887/moov 2>/dev/null || netsurf-gtk http://127.0.0.1:3887/moov"),
            ("📁 Fafnir File Explorer (Win11 Bundle)", "pcmanfm /opt/stormraven/win11"),
            ("❯_ Odin Pantheon & Moov Shell", "lxterminal -T 'Odin Pantheon & Moov AI' -e '/bin/bash -c \"stormraven status; stormraven moov status; exec /bin/bash -i\"'"),
            ("🖴 GParted Partitioner", "sudo gparted"),
            ("🛡 Heimdall Zero-Trust Audit", "__ACTION__:audit"),
            ("🔒 WireGuard VPN + KillSwitch", "lxterminal -T 'StormRaven VPN' -e '/bin/bash -c \"stormraven-vpn status; read -p Press_Enter...\"'"),
        ]

        for idx, (label, cmd) in enumerate(apps):
            btn = Gtk.Button(label=label)
            btn.get_style_context().add_class("app-btn")
            if cmd == "__TAB__:1":
                btn.connect("clicked", lambda *_: self.nb.set_current_page(1))
            elif cmd.startswith("__ACTION__:"):
                act = cmd.split(":", 1)[1]
                btn.connect("clicked", lambda _b, a=act: self.run_Quick_action(a))
            else:
                btn.connect("clicked", lambda _b, c=cmd: self.spawn_cmd(c))
            grid.attach(btn, idx % 4, idx // 4, 1, 1)

        grid_vbox.pack_start(grid, False, False, 0)

        out_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        out_card.get_style_context().add_class("card-box")
        out_hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        out_lbl = Gtk.Label(
            label="Live StormRaven OS Windows 11 Edition & Moov AI SQLite Ledger Output"
        )
        out_lbl.set_xalign(0)
        out_hdr.pack_start(out_lbl, True, True, 0)

        for act_label, act_cmd in [
            ("⚡ Kernel Telemetry", "telemetry"),
            ("📸 Deposit $500 Check", "moov_check"),
            ("💸 $250 ACH Transfer", "moov_ach"),
            ("🏦 Moov Ledger Status", "win11_verify"),
        ]:
            b = Gtk.Button(label=act_label)
            b.get_style_context().add_class("sec-btn")
            b.connect("clicked", lambda _b, a=act_cmd: self.run_Quick_action(a))
            out_hdr.pack_end(b, False, False, 0)

        out_card.pack_start(out_hdr, False, False, 0)

        self.txt_view = Gtk.TextView()
        self.txt_view.set_editable(False)
        self.txt_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.txt_buf = self.txt_view.get_buffer()
        txt_scroll = Gtk.ScrolledWindow()
        txt_scroll.set_min_content_height(215)
        txt_scroll.add(self.txt_view)
        out_card.pack_start(txt_scroll, True, True, 0)

        grid_vbox.pack_start(out_card, True, True, 0)
        grid_scroll.add(grid_vbox)
        self.nb.append_page(
            grid_scroll, Gtk.Label(label="🪟 Windows 11 Edition + System Suite")
        )

        # =====================================================================
        # TAB 2: Interactive Moov AI Banking & Mobile Check Deposit (ACH / mRDC)
        # =====================================================================
        moov_scroll = Gtk.ScrolledWindow()
        moov_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        moov_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        moov_vbox.set_margin_top(12)
        moov_vbox.set_margin_bottom(12)
        moov_vbox.set_margin_start(12)
        moov_vbox.set_margin_end(12)

        forms_hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        forms_hbox.set_homogeneous(True)

        # Left Card: Originate ACH Transfer
        ach_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        ach_card.get_style_context().add_class("card-box")
        ach_title = Gtk.Label()
        ach_title.set_xalign(0)
        ach_title.set_markup("<b>⚡ Originate Same-Day ACH Transfer (94-char .ach NACHA)</b>")
        ach_card.pack_start(ach_title, False, False, 2)

        self.ach_dir = Gtk.ComboBoxText()
        self.ach_dir.append("debit", "ACH Debit / Pull (Deposit into StormRaven Wallet)")
        self.ach_dir.append("credit", "ACH Credit / Push (Send Payout to External Bank)")
        self.ach_dir.set_active(0)
        ach_card.pack_start(self.ach_dir, False, False, 0)

        self.ach_amt = self._labeled_entry(ach_card, "Amount (USD $):", "250.00")
        self.ach_rt = self._labeled_entry(ach_card, "9-Digit ABA Routing (Mod-10):", "021000021")
        self.ach_acct = self._labeled_entry(ach_card, "Bank Account Number:", "4829104921")
        self.ach_memo = self._labeled_entry(ach_card, "SEC Code / Memo:", "StormRaven Same-Day ACH Transfer")

        btn_exec_ach = Gtk.Button(label="⚡ Execute ACH Transfer & Generate NACHA .ach File")
        btn_exec_ach.get_style_context().add_class("cta-btn")
        btn_exec_ach.connect("clicked", self.on_submit_ach)
        ach_card.pack_start(btn_exec_ach, False, False, 4)
        forms_hbox.pack_start(ach_card, True, True, 0)

        # Right Card: Mobile Check Deposit (mRDC)
        chk_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        chk_card.get_style_context().add_class("card-box")
        chk_title = Gtk.Label()
        chk_title.set_xalign(0)
        chk_title.set_markup("<b>📸 Mobile Check Deposit (X9.37 Check 21 .x937 ICL)</b>")
        chk_card.pack_start(chk_title, False, False, 2)

        self.chk_amt = self._labeled_entry(chk_card, "Check Amount (USD $):", "500.00")
        self.chk_payer = self._labeled_entry(chk_card, "Payor / Maker Name:", "Faith Jennings Sovereign Client")
        self.chk_rt = self._labeled_entry(chk_card, "MICR 9-Digit Routing:", "021000021")
        self.chk_acct = self._labeled_entry(chk_card, "MICR Account Number:", "981240112")
        self.chk_num = self._labeled_entry(chk_card, "Check Number:", "1042")

        btn_exec_chk = Gtk.Button(label="📸 Scan MICR & Deposit Check Instantly (.x937 ICL)")
        btn_exec_chk.get_style_context().add_class("cta-btn")
        btn_exec_chk.connect("clicked", self.on_submit_check)
        chk_card.pack_start(btn_exec_chk, False, False, 4)
        forms_hbox.pack_start(chk_card, True, True, 0)

        moov_vbox.pack_start(forms_hbox, False, False, 0)

        # Bottom Ledger & File Output in Tab 2
        moov_out_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        moov_out_card.get_style_context().add_class("card-box")
        moov_out_lbl = Gtk.Label(
            label="Moov AI Transaction Receipt, SQLite Ledger & Generated NACHA (.ach) / Check 21 (.x937) File"
        )
        moov_out_lbl.set_xalign(0)
        moov_out_card.pack_start(moov_out_lbl, False, False, 0)

        self.moov_txt_view = Gtk.TextView()
        self.moov_txt_view.set_editable(False)
        self.moov_txt_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.moov_txt_buf = self.moov_txt_view.get_buffer()
        moov_txt_scroll = Gtk.ScrolledWindow()
        moov_txt_scroll.set_min_content_height(175)
        moov_txt_scroll.add(self.moov_txt_view)
        moov_out_card.pack_start(moov_txt_scroll, True, True, 0)

        moov_vbox.pack_start(moov_out_card, True, True, 0)
        moov_scroll.add(moov_vbox)
        self.nb.append_page(
            moov_scroll, Gtk.Label(label="🏦 Moov AI Banking & Check Deposit (ACH / mRDC)")
        )

        # If launched with /moov in URL, open directly on Tab 2
        if any("/moov" in arg for arg in sys.argv[1:]):
            self.nb.set_current_page(1)

        self.run_Quick_action("win11_verify")

    def _labeled_entry(self, parent, label_text, default_val):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        lbl = Gtk.Label(label=label_text)
        lbl.set_xalign(0)
        lbl.set_size_request(190, -1)
        lbl.get_style_context().add_class("subtitle")
        ent = Gtk.Entry()
        ent.set_text(default_val)
        row.pack_start(lbl, False, False, 0)
        row.pack_start(ent, True, True, 0)
        parent.pack_start(row, False, False, 0)
        return ent

    def spawn_cmd(self, cmd):
        subprocess.Popen(["/bin/bash", "-c", cmd], start_new_session=True)

    def _update_balance_from_json(self, raw_str: str):
        try:
            obj = json.loads(raw_str)
            bal = obj.get("walletBalance", obj.get("availableBalance"))
            if bal is not None:
                self.lbl_top_bal.set_text(f"● MOOV WALLET: ${float(bal):,.2f} USD")
        except Exception:
            pass

    def on_submit_ach(self, *_):
        direction = self.ach_dir.get_active_id() or "debit"
        amt = self.ach_amt.get_text().strip() or "250.00"
        rt = self.ach_rt.get_text().strip() or "021000021"
        acct = self.ach_acct.get_text().strip() or "4829104921"
        memo = self.ach_memo.get_text().strip() or "StormRaven Same-Day ACH Transfer"

        def worker():
            try:
                out = subprocess.check_output(
                    [
                        "python3", "/usr/local/bin/stormraven-moov", "ach",
                        "--direction", direction,
                        "--amount", amt,
                        "--routing", rt,
                        "--account", acct,
                        "--memo", memo,
                    ],
                    text=True, timeout=5,
                )
                self._update_balance_from_json(out)
                parsed = json.loads(out)
                nacha_path = parsed.get("nachaFile", "")
                if nacha_path and os.path.isfile(nacha_path):
                    out += "\n=== GENERATED 94-CHAR NACHA ACH FILE (" + nacha_path + ") ===\n"
                    out += open(nacha_path, "r", encoding="utf-8").read()
            except Exception as e:
                out = f"ACH Error: {e}"
            GLib.idle_add(self.moov_txt_buf.set_text, out)
            GLib.idle_add(self.txt_buf.set_text, out)

        threading.Thread(target=worker, daemon=True).start()

    def on_submit_check(self, *_):
        amt = self.chk_amt.get_text().strip() or "500.00"
        payer = self.chk_payer.get_text().strip() or "Faith Jennings Sovereign Client"
        rt = self.chk_rt.get_text().strip() or "021000021"
        acct = self.chk_acct.get_text().strip() or "981240112"
        num = self.chk_num.get_text().strip() or "1042"

        def worker():
            try:
                out = subprocess.check_output(
                    [
                        "python3", "/usr/local/bin/stormraven-moov", "deposit-check",
                        "--amount", amt,
                        "--payer", payer,
                        "--routing", rt,
                        "--account", acct,
                        "--check-number", num,
                    ],
                    text=True, timeout=5,
                )
                self._update_balance_from_json(out)
                parsed = json.loads(out)
                x937_path = parsed.get("x937File", "")
                if x937_path and os.path.isfile(x937_path):
                    out += "\n=== GENERATED X9.37 CHECK 21 CASH LETTER (" + x937_path + ") ===\n"
                    out += open(x937_path, "r", encoding="utf-8").read()
            except Exception as e:
                out = f"Check Deposit Error: {e}"
            GLib.idle_add(self.moov_txt_buf.set_text, out)
            GLib.idle_add(self.txt_buf.set_text, out)

        threading.Thread(target=worker, daemon=True).start()

    def run_Quick_action(self, action):
        def worker():
            try:
                if action == "win11_verify":
                    moov_out = subprocess.check_output(
                        ["python3", "/usr/local/bin/stormraven-moov", "status"], text=True, timeout=4
                    )
                    self._update_balance_from_json(moov_out)
                    lines = [
                        "=== STORMRAVEN OS v3.9.0 — WINDOWS 11 EDITION + MOOV AI (ACTIVE ON HP PRO 3500) ===",
                    ]
                    for wdir in ("/opt/stormraven/win11", "/mnt/STORMRAVEN_WIN11"):
                        kpath = os.path.join(wdir, "bin", "StormRaven.Kernel.exe")
                        if os.path.exists(kpath):
                            sz = os.path.getsize(kpath) / (1024 * 1024)
                            lines.append(f"✓ Windows 11 Edition Bundle Installed: {wdir} (StormRaven.Kernel.exe {sz:.1f} MB)")
                            break
                    lines.append("\n=== MOOV AI FINANCIAL & MOBILE CHECK DEPOSIT ENGINE (SQLITE + NACHA/X9.37) ===")
                    lines.append(moov_out.strip())
                    out = "\n".join(lines)
                elif action == "moov_check":
                    out = subprocess.check_output(
                        [
                            "python3", "/usr/local/bin/stormraven-moov", "deposit-check",
                            "--amount", "500.00", "--routing", "021000021",
                            "--account", "981240112", "--check-number", "1042",
                            "--payer", "Faith Jennings Sovereign Treasury"
                        ],
                        text=True, timeout=4
                    )
                    self._update_balance_from_json(out)
                elif action == "moov_ach":
                    out = subprocess.check_output(
                        [
                            "python3", "/usr/local/bin/stormraven-moov", "ach",
                            "--amount", "250.00", "--routing", "021000021",
                            "--account", "4829104921", "--direction", "debit",
                            "--memo", "StormRaven Windows 11 Edition Same-Day ACH"
                        ],
                        text=True, timeout=4
                    )
                    self._update_balance_from_json(out)
                elif action == "audit":
                    out = subprocess.check_output(["/usr/local/bin/stormraven", "baseline-audit"], text=True, timeout=4)
                elif action == "update":
                    out = subprocess.check_output(["/usr/local/bin/stormraven-update", "--status-json"], text=True, timeout=15)
                elif action == "layout_toggle":
                    out = subprocess.check_output(["/usr/local/bin/stormraven-theme-layout", "toggle"], text=True, timeout=5)
                else:
                    with urllib.request.urlopen("http://127.0.0.1:8787/health", timeout=2) as r:
                        data = json.loads(r.read().decode())
                    out = json.dumps(data.get("data", data), indent=2)
            except Exception as exc:
                out = f"StormRaven OS v3.9.0 Windows 11 Edition + Moov AI Status: ONLINE\n({exc})"
            GLib.idle_add(self.txt_buf.set_text, out)
            GLib.idle_add(self.moov_txt_buf.set_text, out)

        threading.Thread(target=worker, daemon=True).start()


if __name__ == "__main__":
    win = StormRavenCommandCenter()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
