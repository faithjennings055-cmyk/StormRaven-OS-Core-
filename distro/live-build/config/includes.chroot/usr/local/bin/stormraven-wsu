#!/usr/bin/env bash
# =============================================================================
# StormRaven OS — Windows Subsystem for Ubuntu (WSU / Windows Sovereign Cell)
# =============================================================================
# Implements Issue #96 with Cerise's spec + Echo's 3 security tightening gates:
#   1. Host-side Heimdall Gate with HMAC-SHA256 + timestamp (±60s) + nonce
#      replay cache so a compromised VM cannot replay a captured signature.
#   2. Wine/bwrap secondary execution checks binary SHA-256 digests against the
#      in-repo distro/PROVENANCE.json manifest before running inside Bubblewrap.
#   3. Shared-folder scanning reuses the Helheim Quarantine Vault (/helheim)
#      to quarantine any suspect file crossing the host-guest boundary.
# =============================================================================
set -euo pipefail

WSU_BASE="${STORMRAVEN_WSU_DIR:-${HOME:-/tmp}/.local/share/stormraven-wsu}"
VOID_BASE="${STORMRAVEN_VOID_DIR:-/tmp/stormraven-void}"
HELHEIM_DIR="${VOID_BASE}/helheim"
NONCE_FILE="${VOID_BASE}/wsu_nonces.log"
SHARED_DIR="${WSU_BASE}/shared"

mkdir -p "${WSU_BASE}/prefix" "${WSU_BASE}/c_drive" "${SHARED_DIR}" "${HELHEIM_DIR}" 2>/dev/null || {
  WSU_BASE="/tmp/stormraven-void/wsu"
  SHARED_DIR="${WSU_BASE}/shared"
  mkdir -p "${WSU_BASE}/prefix" "${WSU_BASE}/c_drive" "${SHARED_DIR}" "${HELHEIM_DIR}"
}
touch "${NONCE_FILE}" 2>/dev/null || true

export WINEPREFIX="${WSU_BASE}/prefix"
export WINEARCH="win64"
export WINEDEBUG="-all"

PROVENANCE_PATH="/opt/stormraven/PROVENANCE.json"
[ -f "${PROVENANCE_PATH}" ] || PROVENANCE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../../.." 2>/dev/null && pwd)/distro/PROVENANCE.json"

usage() {
  cat <<EOF
Usage: stormraven-wsu <command> [args]   (alias: wsu)

Commands:
  status                              Show Windows Sovereign Cell & Wine/bwrap status (JSON)
  init                                Initialize Wine64, Bubblewrap, FreeRDP & binfmt_misc
  verify-ipc <json-payload> <hmac>    Host-side Heimdall Gate: verify timestamp + nonce + allow-list
  scan-shared [dir]                   Scan shared host-guest folder & quarantine threats to Helheim
  run <app.exe|builtin> [args]        Verify SHA-256 against PROVENANCE.json & run in bwrap/Wine64
  cell <start|stop|status|heartbeat>  Manage the RavenNest Windows 11 KVM Sovereign Cell
EOF
}

cmd="${1:-status}"
case "${cmd}" in
  status)
    wine_installed="false"
    command -v wine >/dev/null 2>&1 || command -v wine64 >/dev/null 2>&1 && wine_installed="true"
    bwrap_installed="false"
    command -v bwrap >/dev/null 2>&1 && bwrap_installed="true"
    freerdp_installed="false"
    command -v xfreerdp >/dev/null 2>&1 && freerdp_installed="true"
    cell_running="false"
    pgrep -f "qemu-system-x86_64.*Win11" >/dev/null 2>&1 && cell_running="true"
    quarantined_count="$(find "${HELHEIM_DIR}" -maxdepth 1 -name '*.void' 2>/dev/null | wc -l | tr -d ' ')"
    printf '{"subsystem":"Windows Subsystem for Ubuntu (WSU)","primaryArchitecture":"RavenNest Windows 11 Sovereign Cell (KVM/QEMU)","secondaryArchitecture":"Wine64 + Bubblewrap (bwrap)","heimdallGate":"HMAC-SHA256 + Timestamp (60s) + Nonce Anti-Replay","sharedFolderScanner":"Helheim Quarantine Vault (%s)","quarantinedItems":%s,"cellRunning":%s,"wineInstalled":%s,"bwrapInstalled":%s,"freerdpSeamlessBridge":%s}\n' \
      "${HELHEIM_DIR}" "${quarantined_count}" "${cell_running}" "${wine_installed}" "${bwrap_installed}" "${freerdp_installed}"
    ;;

  verify-ipc)
    payload="${2:?JSON payload required}"
    sig="${3:?HMAC-SHA256 signature required}"
    python3 - "${payload}" "${sig}" "${NONCE_FILE}" <<'PY'
import hashlib, hmac, json, os, sys, time

raw_payload, provided_sig, nonce_file = sys.argv[1:4]
ALLOWLIST = {"cell_heartbeat", "launch_remoteapp", "sync_clipboard", "query_status", "raido_route", "isa_snapshot"}

key = "SR-LUCI-INFINITY-SOVEREIGN-KEY-v3.3"
for kp in ("/etc/stormraven/Luci.key", os.path.expanduser("~/.stormraven_luci.key")):
    if os.path.isfile(kp):
        try:
            key = open(kp, "r", encoding="utf-8").read().strip()
            break
        except Exception:
            pass

expected_sig = hmac.new(key.encode("utf-8"), raw_payload.encode("utf-8"), hashlib.sha256).hexdigest()
if not hmac.compare_digest(expected_sig, provided_sig.strip()):
    print(json.dumps({"ok": False, "verdict": "BLOCKED", "reason": "invalid_hmac_signature"}))
    sys.exit(1)

data = json.loads(raw_payload)
ts = int(data.get("timestamp", 0))
nonce = str(data.get("nonce", "")).strip()
intent = str(data.get("intent", "")).strip()

if abs(int(time.time()) - ts) > 60:
    print(json.dumps({"ok": False, "verdict": "BLOCKED", "reason": "timestamp_outside_60s_window"}))
    sys.exit(1)

if not nonce or len(nonce) < 8:
    print(json.dumps({"ok": False, "verdict": "BLOCKED", "reason": "missing_or_short_nonce"}))
    sys.exit(1)

seen = set()
if os.path.isfile(nonce_file):
    seen = set(open(nonce_file, "r", encoding="utf-8").read().splitlines())
if nonce in seen:
    print(json.dumps({"ok": False, "verdict": "BLOCKED", "reason": "replayed_nonce_detected"}))
    sys.exit(1)

if intent not in ALLOWLIST:
    print(json.dumps({"ok": False, "verdict": "BLOCKED", "reason": f"intent '{intent}' not in Heimdall WSU allow-list"}))
    sys.exit(1)

with open(nonce_file, "a", encoding="utf-8") as nf:
    nf.write(nonce + "\n")

print(json.dumps({"ok": True, "verdict": "PASS", "intent": intent, "nonce": nonce, "timestamp": ts}))
PY
    ;;

  scan-shared)
    scan_dir="${2:-$SHARED_DIR}"
    python3 - "${scan_dir}" "${HELHEIM_DIR}" <<'PY'
import hashlib, json, os, shutil, sys, time

scan_dir, helheim_dir = sys.argv[1:3]
os.makedirs(scan_dir, exist_ok=True)
os.makedirs(helheim_dir, exist_ok=True)

BAD_SIGNATURES = [b"Invoke-Mimikatz", b"powershell -enc", b"cmd.exe /c rd /s /q", b"rm -rf /", b"vssadmin delete shadows"]
scanned = 0
quarantined = []

for root, _, files in os.walk(scan_dir):
    for fn in files:
        fpath = os.path.join(root, fn)
        scanned += 1
        try:
            data = open(fpath, "rb").read(262144)
        except Exception:
            continue
        flagged = any(sig in data for sig in BAD_SIGNATURES)
        if flagged:
            digest = hashlib.sha256(data).hexdigest()[:12]
            qname = f"wsu_{os.path.basename(fn)}_{digest}.void"
            qpath = os.path.join(helheim_dir, qname)
            shutil.move(fpath, qpath)
            quarantined.append({"file": fn, "quarantinePath": qpath, "sha256Prefix": digest})

print(json.dumps({
    "ok": True,
    "scannedFiles": scanned,
    "quarantinedCount": len(quarantined),
    "quarantined": quarantined,
    "helheimVault": helheim_dir,
    "checkedUtc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
}))
PY
    ;;

  run|exec)
    shift || true
    target="${1:?Windows executable or builtin name required}"
    shift || true
    BUILTINS=("notepad" "cmd" "regedit" "explorer" "winecfg" "taskmgr")
    is_builtin="false"
    for b in "${BUILTINS[@]}"; do
      [ "${target}" = "${b}" ] && is_builtin="true"
    done
    if [ "${is_builtin}" = "false" ]; then
      if [ ! -f "${target}" ]; then
        echo "[WSU Heimdall Gate] Error: File not found: ${target}" >&2
        exit 1
      fi
      actual_sha="$(sha256sum "${target}" | awk '{print $1}')"
      if [ -f "${PROVENANCE_PATH}" ] && ! grep -qi "${actual_sha}" "${PROVENANCE_PATH}"; then
        echo "[WSU Heimdall Gate] BLOCKED: Binary SHA-256 (${actual_sha}) is not approved in ${PROVENANCE_PATH}." >&2
        exit 2
      fi
    fi
    WINE_BIN="$(command -v wine64 || command -v wine || echo /usr/bin/wine64)"
    if command -v bwrap >/dev/null 2>&1; then
      exec bwrap --ro-bind /usr /usr --ro-bind /lib /lib --ro-bind /lib64 /lib64 --ro-bind /etc /etc \
        --bind "${WSU_BASE}" "${WSU_BASE}" --dev /dev --proc /proc --tmpfs /tmp \
        --unshare-ipc --unshare-pid "${WINE_BIN}" "${target}" "$@"
    else
      exec "${WINE_BIN}" "${target}" "$@"
    fi
    ;;

  cell)
    sub="${2:-status}"
    case "${sub}" in
      start)
        exec /usr/local/bin/vm-win11.sh
        ;;
      stop)
        pkill -f "qemu-system-x86_64.*Win11" 2>/dev/null || true
        echo '{"cell":"RavenNest Windows 11 Sovereign Cell","status":"stopped"}'
        ;;
      heartbeat)
        python3 - "${NONCE_FILE}" <<'PY'
import hashlib, hmac, json, os, subprocess, sys, time, uuid
nonce_file = sys.argv[1]
key = "SR-LUCI-INFINITY-SOVEREIGN-KEY-v3.3"
for kp in ("/etc/stormraven/Luci.key", os.path.expanduser("~/.stormraven_luci.key")):
    if os.path.isfile(kp):
        try:
            key = open(kp, "r", encoding="utf-8").read().strip()
            break
        except Exception:
            pass
payload = json.dumps({"intent": "cell_heartbeat", "timestamp": int(time.time()), "nonce": uuid.uuid4().hex})
sig = hmac.new(key.encode("utf-8"), payload.encode("utf-8"), hashlib.sha256).hexdigest()
res = subprocess.run(["/bin/bash", "/usr/local/bin/stormraven-wsu", "verify-ipc", payload, sig], capture_output=True, text=True)
print(res.stdout.strip())
PY
        ;;
      status|*)
        running="false"
        pgrep -f "qemu-system-x86_64.*Win11" >/dev/null 2>&1 && running="true"
        printf '{"cell":"RavenNest Windows 11 Sovereign Cell","running":%s,"bridge":"FreeRDP + KVM/QEMU","gatekeeper":"Heimdall HMAC-SHA256 + Timestamp + Nonce"}\n' "${running}"
        ;;
    esac
    ;;

  init)
    if [ "$(id -u)" -eq 0 ]; then SUDO=""; else SUDO="sudo"; fi
    $SUDO apt-get update -qq || true
    $SUDO apt-get install -y --no-install-recommends wine64 wine winetricks bubblewrap freerdp2-x11 binfmt-support || true
    echo "[WSU] Initialized Wine64 + Bubblewrap + FreeRDP Sovereign Cell bridge."
    ;;

  *)
    usage
    exit 1
    ;;
esac
