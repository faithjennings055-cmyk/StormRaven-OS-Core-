#!/usr/bin/env bash
# =============================================================================
# StormRaven OS: Ymir Edition (v3.9.0) — Dual-Boot USB & Disk Builder
# =============================================================================
# Regression story (Issue #108, 2026-11-16 Surface 3 incident; pattern source #87):
#   A boot-repair sequence from Windows RE used 'assign letter=S' on an ambiguous
#   disk selection in a multi-drive machine (58GB SSD + 119GB microSD + 465GB
#   external USB all attached). Firmware 'Boot Option Restoration' auto-reset
#   boot config and caused a 1-hour red-screen bootloop.
#   Rule: Every recovery/flashing script MUST resolve and verify the target disk
#   by MODEL / SERIAL / LABEL / UUID / SIZE before any write, refuse internal OS
#   disks (/dev/mmcblk0*, /dev/nvme0n1*, /dev/loop*, /dev/zram*, rootdev -s -d),
#   support --verify-mode (lists disks with labels and serials and prompts for
#   the target serial), and require typing ERASE before touching a block device.
#
# Tested paste-ready one-liner:
#   cd /tmp && curl -fsSLO https://01a11428-2aab-7e12-9d89-3543f658a191.skydive.app/stormraven-dualboot && curl -fsSLO https://01a11428-2aab-7e12-9d89-3543f658a191.skydive.app/stormraven-dualboot.sha256 && sha256sum -c stormraven-dualboot.sha256 && sudo bash stormraven-dualboot --verify-mode
#
# Usage:
#   sudo stormraven-dualboot list
#   sudo stormraven-dualboot --verify-mode      # list disks + serials, prompt for serial
#   sudo stormraven-dualboot ventoy [/dev/sdX]  # Build Ventoy Dual-Edition USB (Ubuntu + Win11)
#   sudo stormraven-dualboot usb /dev/sdX
#   sudo stormraven-dualboot grub-add-win11 /dev/sdXY
#   sudo stormraven-dualboot grub-verify        # scan grub configs for stale UUIDs
# =============================================================================
set -euo pipefail

# Downloads use the STABLE edition endpoints (/file/<edition>), which are
# rename-proof: the server resolves the current canonical filename itself. A
# rebuild that renames an artifact can never turn these into dead links.
UBUNTU_ISO_URL="https://echo-at-faith-s-workspace-2.skydive.app/file/ubuntu"
UBUNTU_SHA_URL="https://echo-at-faith-s-workspace-2.skydive.app/downloads/StormRavenOS-Ubuntu-26.04-amd64.iso.sha256"
WIN11_ISO_URL="https://echo-at-faith-s-workspace-2.skydive.app/file/win11"
WIN11_SHA_URL="https://echo-at-faith-s-workspace-2.skydive.app/downloads/StormRavenOS-Windows11-25H2-x64.iso.sha256"

# NEVER fall back to a hardcoded checksum. A constant drifts the moment an
# artifact is rebuilt, and a stale constant silently "verifies" an old build.
# If the published sidecar cannot be fetched, refuse to proceed.
fetch_published_sha() {
  local label="$1" url="$2" out
  out="$(curl -fsSL "$url" 2>/dev/null | awk '{print $1}')"
  if ! printf '%s' "$out" | grep -qE '^[0-9a-f]{64}$'; then
    echo "CRITICAL SAFETY STOP: could not fetch the published SHA-256 for ${label} from ${url}. Refusing to proceed without a verifiable checksum." >&2
    exit 1
  fi
  printf '%s' "$out"
}

UBUNTU_ISO_SHA="$(fetch_published_sha 'Ubuntu 26.04' "$UBUNTU_SHA_URL")"
WIN11_ISO_SHA="$(fetch_published_sha 'Windows 11 25H2' "$WIN11_SHA_URL")"

CACHE_DIR="/var/tmp/stormraven-dualboot-cache"
UBUNTU_ISO="${CACHE_DIR}/StormRavenOS-Ubuntu-26.04-amd64.iso"
WIN11_ISO="${CACHE_DIR}/StormRavenOS-Windows11-25H2-x64.iso"


# --- UUID sanity: every UUID written to grub config must exist on disk ---
verify_uuids_in_cfg() {
  local cfg="$1" missing=0
  for u in $(grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' "$cfg" | sort -u); do
    if ! blkid -s UUID -o value | grep -q "^${u}$"; then
      echo "  !! STALE UUID in $cfg: $u (no block device has it)"
      missing=$((missing+1))
    fi
  done
  if [ "$missing" -gt 0 ]; then
    echo "REFUSING: $cfg references $missing UUID(s) that do not exist on any block device."
    echo "The boot config would brick the next reboot. Fix or regenerate before installing."
    return 1
  fi
  echo "  OK: all UUIDs in $cfg resolve to real block devices."
  return 0
}

# grub-verify: scan existing grub configs for stale UUIDs
grub_verify() {
  echo "======================================================================="
  echo " ✦ GRUB UUID VERIFIER - checking every referenced UUID exists"
  echo "======================================================================="
  local rc=0
  for cfg in /boot/grub/grub.cfg /boot/grub2/grub.cfg /etc/grub.d/40_custom /boot/efi/EFI/*/grub.cfg; do
    [ -f "$cfg" ] || continue
    echo "==> $cfg"
    verify_uuids_in_cfg "$cfg" || rc=1
  done
  [ "$rc" = "0" ] && echo "✦ All grub configs healthy." || echo "✦ STALE UUIDs FOUND - run update-grub against the real /boot, or re-run this tool's install path."
  return $rc
}

list_disks() {
  echo "======================================================================="
  echo " ✦ DETECTED DRIVES (MODEL · SERIAL · SIZE · TRAN · RM · LABELS)"
  echo "======================================================================="
  if [ -n "${STORMRAVEN_FAKE_LSBLK_FILE:-}" ] && [ -f "${STORMRAVEN_FAKE_LSBLK_FILE}" ]; then
    cat "${STORMRAVEN_FAKE_LSBLK_FILE}"
  else
    lsblk -d -o NAME,SIZE,MODEL,SERIAL,TRAN,RM,TYPE 2>/dev/null | awk 'NR==1 || $NF=="disk"' || \
      lsblk -d -o NAME,SIZE,TRAN,RM,TYPE,MODEL | awk 'NR==1 || $5=="disk"'
    echo ""
    echo "Partition Labels & UUIDs:"
    lsblk -o NAME,SIZE,FSTYPE,LABEL,UUID,MOUNTPOINT 2>/dev/null || true
  fi
  echo ""
  echo "Tip: Look for RM=1 or TRAN=usb for your USB flash drive (16GB+ recommended)."
  echo "To verify a disk by serial number interactively (Core #108):"
  echo "  sudo stormraven-dualboot --verify-mode"
  echo "To build a Dual-Boot USB (Ubuntu 26.04 + Custom Windows 11 on one stick):"
  echo "  sudo stormraven-dualboot usb /dev/sdX"
  echo "======================================================================="
}

# Core #108 verify-mode: lists disks with labels & serials, asks user to type the serial of intended target
verify_mode_select() {
  list_disks
  printf "Enter the SERIAL (or exact LABEL) of the target drive to verify: "
  local wanted_serial=""
  read -r wanted_serial
  if [ -z "${wanted_serial}" ]; then
    echo "CRITICAL: Empty serial/label entered. Failing closed." >&2
    return 1
  fi
  local matched_dev=""
  if [ -n "${STORMRAVEN_FAKE_LSBLK_FILE:-}" ] && [ -f "${STORMRAVEN_FAKE_LSBLK_FILE}" ]; then
    matched_dev="$(awk -v s="${wanted_serial}" 'NR>1 && ($4 == s || $3 == s) {print "/dev/"$1; exit}' "${STORMRAVEN_FAKE_LSBLK_FILE}" 2>/dev/null || true)"
  else
    matched_dev="$(lsblk -dpno NAME,SERIAL,LABEL 2>/dev/null | awk -v s="${wanted_serial}" '$2 == s || $3 == s {print $1; exit}' || true)"
    if [ -z "${matched_dev}" ]; then
      local part_match
      part_match="$(blkid -L "${wanted_serial}" 2>/dev/null || true)"
      if [ -n "${part_match}" ] && [ -b "${part_match}" ]; then
        local pk
        pk="$(lsblk -no PKNAME "${part_match}" 2>/dev/null | head -n 1 || true)"
        matched_dev="${pk:+/dev/${pk}}"
        matched_dev="${matched_dev:-${part_match}}"
      fi
    fi
  fi
  if [ -z "${matched_dev}" ]; then
    echo "CRITICAL: No attached drive matches serial/label '${wanted_serial}'. Failing closed." >&2
    return 1
  fi
  echo "RESOLVED TARGET:"
  echo "  Device         : ${matched_dev}"
  echo "  Matched Serial : ${wanted_serial}"
  if [ -b "${matched_dev}" ]; then
    lsblk -d -o NAME,SIZE,MODEL,SERIAL,TRAN,RM "${matched_dev}" 2>/dev/null || true
  fi
  return 0
}

# Core #108 hardware guard before any destructive disk/partition write
enforce_core108_guard() {
  local dev="$1"
  if [ -z "${dev}" ]; then
    echo "CRITICAL: No target device specified. Failing closed." >&2
    exit 1
  fi
  local root_src root_disk=""
  root_src="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
  if [ -n "${root_src}" ]; then
    local pk
    pk="$(lsblk -no PKNAME "${root_src}" 2>/dev/null | head -n 1 || true)"
    root_disk="${pk:+/dev/${pk}}"
    root_disk="${root_disk:-${root_src}}"
  fi
  local chrome_root=""
  if command -v rootdev >/dev/null 2>&1; then
    chrome_root="$(rootdev -s -d 2>/dev/null || true)"
  fi
  if { [ -n "${root_disk}" ] && [[ "${dev}" == "${root_disk}"* ]]; } || \
     { [ -n "${chrome_root}" ] && [[ "${dev}" == "${chrome_root}"* ]]; }; then
    echo "CRITICAL SAFETY STOP: ${dev} is the active OS boot drive (${root_disk:-${chrome_root}})! Failing closed." >&2
    exit 1
  fi
  case "${dev}" in
    /dev/mmcblk0*|/dev/nvme0n1*|/dev/loop*|/dev/zram*)
      echo "CRITICAL SAFETY STOP: Refusing to overwrite protected internal/virtual block device (${dev}). Failing closed." >&2
      exit 1
      ;;
  esac
  echo "======================================================================="
  echo " ✦ CORE #108 TARGET VERIFICATION BEFORE WRITE:"
  echo "======================================================================="
  echo "RESOLVED TARGET:"
  echo "  Device : ${dev}"
  lsblk -d -o NAME,SIZE,MODEL,SERIAL,TRAN,RM "${dev}" 2>/dev/null || lsblk -d -o NAME,SIZE,MODEL,TRAN,RM "${dev}" 2>/dev/null || true
  echo "  Labels : $(lsblk -lnpo LABEL,UUID "${dev}" 2>/dev/null | xargs || echo none)"
  echo ""
  if [ "${STORMRAVEN_CONFIRM:-0}" != "1" ]; then
    printf "Type ERASE in all caps to confirm writing to %s (anything else cancels): " "${dev}"
    local confirm_val=""
    read -r confirm_val
    if [ "${confirm_val}" != "ERASE" ]; then
      echo "Cancelled. Nothing was written."
      exit 1
    fi
  fi
}

download_and_verify_isos() {
  mkdir -p "${CACHE_DIR}"

  echo "==> [1/5] Checking & verifying StormRaven OS Ubuntu 26.04 Ymir ISO (1.7 GB)..."
  if [ ! -s "${UBUNTU_ISO}" ] || [ "$(sha256sum "${UBUNTU_ISO}" | awk '{print $1}')" != "${UBUNTU_ISO_SHA}" ]; then
    rm -f "${UBUNTU_ISO}.part"
    curl -fL --retry 3 -C - -o "${UBUNTU_ISO}.part" "${UBUNTU_ISO_URL}"
    # Only publish the file once the bytes verify: a partial download never
    # occupies the final name.
    echo "${UBUNTU_ISO_SHA}  ${UBUNTU_ISO}.part" | sha256sum -c -
    mv -f "${UBUNTU_ISO}.part" "${UBUNTU_ISO}"
  fi
  echo "${UBUNTU_ISO_SHA}  ${UBUNTU_ISO}" | sha256sum -c -

  echo "==> [2/5] Checking & verifying StormRaven OS Custom Windows 11 Ymir ISO (6.8 GB)..."
  if [ ! -s "${WIN11_ISO}" ] || [ "$(sha256sum "${WIN11_ISO}" | awk '{print $1}')" != "${WIN11_ISO_SHA}" ]; then
    rm -f "${WIN11_ISO}.part"
    curl -fL --retry 3 -C - -o "${WIN11_ISO}.part" "${WIN11_ISO_URL}"
    # Only publish the file once the bytes verify: a partial download never
    # occupies the final name.
    echo "${WIN11_ISO_SHA}  ${WIN11_ISO}.part" | sha256sum -c -
    mv -f "${WIN11_ISO}.part" "${WIN11_ISO}"
  fi
  echo "${WIN11_ISO_SHA}  ${WIN11_ISO}" | sha256sum -c -
}

build_dualboot_usb() {
  local TARGET_DEV="${1:-}"
  if [ -z "${TARGET_DEV}" ] || [ ! -b "${TARGET_DEV}" ]; then
    echo "ERROR: Please pass a valid block device (e.g., sudo stormraven-dualboot usb /dev/sdb)" >&2
    list_disks
    exit 1
  fi

  enforce_core108_guard "${TARGET_DEV}"

  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq || true
  apt-get install -y -qq parted dosfstools ntfs-3g exfatprogs grub-efi-amd64-bin grub-pc-bin p7zip-full rsync wimtools >/dev/null

  download_and_verify_isos

  echo "==> [3/5] Partitioning ${TARGET_DEV} for Dual-Boot (BIOS Boot + 1GB EFI + 3GB Ubuntu Live + NTFS Windows 11)..."
  for mp in $(lsblk -ln -o NAME "${TARGET_DEV}" | tail -n +2); do
    umount -lf "/dev/${mp}" 2>/dev/null || true
  done

  wipefs -a "${TARGET_DEV}" >/dev/null 2>&1 || true
  parted -s "${TARGET_DEV}" mklabel gpt
  parted -s "${TARGET_DEV}" mkpart bios_grub 1MiB 3MiB
  parted -s "${TARGET_DEV}" set 1 bios_grub on
  parted -s "${TARGET_DEV}" mkpart SR_EFI fat32 3MiB 515MiB
  parted -s "${TARGET_DEV}" set 2 esp on
  parted -s "${TARGET_DEV}" mkpart SR_UBUNTU ext4 515MiB 3587MiB
  parted -s "${TARGET_DEV}" mkpart SR_WIN11 ntfs 3587MiB 100%
  partprobe "${TARGET_DEV}" 2>/dev/null || true
  sleep 2

  local P_PREFIX="${TARGET_DEV}"
  case "${TARGET_DEV}" in
    *nvme*|*mmcblk*|*loop*) P_PREFIX="${TARGET_DEV}p" ;;
  esac
  local P_EFI="${P_PREFIX}2"
  local P_UBU="${P_PREFIX}3"
  local P_WIN="${P_PREFIX}4"

  mkfs.vfat -F 32 -n "SR_EFI" "${P_EFI}" >/dev/null
  mkfs.ext4 -F -L "SR_UBUNTU" "${P_UBU}" >/dev/null
  mkfs.ntfs -Q -F -L "SR_WIN11" "${P_WIN}" >/dev/null

  local MNT_BASE="/mnt/sr-dualboot"
  mkdir -p "${MNT_BASE}/efi" "${MNT_BASE}/ubuntu" "${MNT_BASE}/win11"
  mount "${P_EFI}" "${MNT_BASE}/efi"
  mount "${P_UBU}" "${MNT_BASE}/ubuntu"
  mount "${P_WIN}" "${MNT_BASE}/win11"

  echo "==> [4/5] Extracting StormRaven Ubuntu 26.04 & Custom Windows 11 25H2 onto ${TARGET_DEV}..."
  7z x -y -snl "${UBUNTU_ISO}" -o"${MNT_BASE}/ubuntu" >/dev/null || [ -f "${MNT_BASE}/ubuntu/casper/filesystem.squashfs" ]
  mkdir -p "${MNT_BASE}/ubuntu/live"
  ln -sf ../casper/filesystem.squashfs "${MNT_BASE}/ubuntu/live/filesystem.squashfs" 2>/dev/null || true
  ln -sf ../casper/initrd "${MNT_BASE}/ubuntu/live/initrd" 2>/dev/null || true
  ln -sf ../casper/vmlinuz "${MNT_BASE}/ubuntu/live/vmlinuz" 2>/dev/null || true
  7z x -y "${WIN11_ISO}" -o"${MNT_BASE}/win11" >/dev/null || [ -f "${MNT_BASE}/win11/sources/install.wim" ] || [ -f "${MNT_BASE}/win11/efi/boot/bootx64.efi" ]

  # Ensure Windows 11 hardware-check bypass autounattend.xml (#97) is always staged on the Win11 partition root
  if [ ! -s "${MNT_BASE}/win11/autounattend.xml" ] || ! grep -q "BypassTPMCheck" "${MNT_BASE}/win11/autounattend.xml" 2>/dev/null; then
    cat > "${MNT_BASE}/win11/autounattend.xml" <<'UNATTEND_EOF'
<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassTPMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassSecureBootCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassRAMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassStorageCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>5</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassCPUCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>false</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
    </component>
  </settings>
</unattend>
UNATTEND_EOF
  fi
  cp -f "${MNT_BASE}/win11/autounattend.xml" "${MNT_BASE}/efi/autounattend.xml" 2>/dev/null || true

  # Ensure case-consistent /efi/boot/bootx64.efi on the Win11 partition for GRUB chainloader
  if [ ! -f "${MNT_BASE}/win11/efi/boot/bootx64.efi" ]; then
    mkdir -p "${MNT_BASE}/win11/efi/boot"
    for cand in "${MNT_BASE}/win11/EFI/BOOT/BOOTX64.EFI" "${MNT_BASE}/win11/efi/microsoft/boot/bootmgfw.efi" "${MNT_BASE}/win11/EFI/Microsoft/Boot/bootmgfw.efi"; do
      if [ -f "$cand" ]; then
        cp -f "$cand" "${MNT_BASE}/win11/efi/boot/bootx64.efi"
        break
      fi
    done
  fi
  # Copy UEFI bootloaders to the ESP and install unified Dual-Boot GRUB menu
  cp -a "${MNT_BASE}/win11/efi" "${MNT_BASE}/efi/" 2>/dev/null || true
  cp -a "${MNT_BASE}/win11/boot" "${MNT_BASE}/efi/" 2>/dev/null || true

  echo "==> [5/5] Installing Unified StormRaven Dual-Boot GRUB Bootloader (UEFI + BIOS)..."
  grub-install --target=i386-pc --boot-directory="${MNT_BASE}/efi/boot" --recheck "${TARGET_DEV}" 2>/dev/null || true
  grub-install --target=x86_64-efi --efi-directory="${MNT_BASE}/efi" --boot-directory="${MNT_BASE}/efi/boot" --removable --no-nvram 2>/dev/null || true

  local UBU_UUID WIN_UUID
  UBU_UUID="$(blkid -s UUID -o value "${P_UBU}")"
  WIN_UUID="$(blkid -s UUID -o value "${P_WIN}")"

  mkdir -p "${MNT_BASE}/efi/boot/grub"
  cat > "${MNT_BASE}/efi/boot/grub/grub.cfg" <<GRUBCFG
set timeout=15
set default=0

insmod part_gpt
insmod ext2
insmod fat
insmod ntfs
insmod search_fs_uuid
insmod chain

menuentry "1) StormRaven OS: Ymir Edition — Ubuntu 26.04 LTS (Try or Install)" {
    search --no-floppy --fs-uuid --set=root ${UBU_UUID}
    linux /casper/vmlinuz boot=casper ignore_uuid quiet splash
    initrd /casper/initrd
}

menuentry "2) StormRaven OS: Ymir Edition — Custom Windows 11 (25H2 Installer)" {
    search --no-floppy --fs-uuid --set=root ${WIN_UUID}
    chainloader /efi/boot/bootx64.efi
}

menuentry "3) StormRaven OS: Ubuntu 26.04 — Bare-Metal Disk Installer" {
    search --no-floppy --fs-uuid --set=root ${UBU_UUID}
    linux /casper/vmlinuz boot=casper ignore_uuid stormraven.mode=install
    initrd /casper/initrd
}

menuentry "4) StormRaven OS: Ubuntu 26.04 — Safe Graphics Mode (nomodeset)" {
    search --no-floppy --fs-uuid --set=root ${UBU_UUID}
    linux /casper/vmlinuz boot=casper ignore_uuid nomodeset
    initrd /casper/initrd
}
GRUBCFG

  sync
  umount -lf "${MNT_BASE}/win11" "${MNT_BASE}/ubuntu" "${MNT_BASE}/efi" 2>/dev/null || true

  echo "======================================================================="
  echo " ✦ STORMRAVEN OS DUAL-BOOT USB COMPLETE ON ${TARGET_DEV}!"
  echo "   • Option 1: StormRaven OS — Ubuntu 26.04 LTS Ymir Edition"
  echo "   • Option 2: StormRaven OS — Custom Windows 11 (25H2) Ymir Edition"
  echo "   Reboot and press F9/F12 to boot from ${TARGET_DEV}."
  echo "======================================================================="
}

stage_internal_dualboot() {
  local TARGET_PART="${1:-}"
  if [ -z "${TARGET_PART}" ] || [ ! -b "${TARGET_PART}" ]; then
    echo "Usage: sudo stormraven-dualboot disk-part /dev/sdXY" >&2
    echo "Formats the target partition as NTFS, extracts the Custom Windows 11 Ymir ISO onto it," >&2
    echo "and adds 'StormRaven OS — Custom Windows 11 (25H2) Ymir Edition' to your HP GRUB boot menu!" >&2
    lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT
    exit 1
  fi

  enforce_core108_guard "${TARGET_PART}"

  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq || true
  apt-get install -y -qq ntfs-3g p7zip-full os-prober >/dev/null

  echo "==> Verifying StormRaven OS Custom Windows 11 Ymir ISO (6.8 GB)..."
  mkdir -p "${CACHE_DIR}"
  if [ ! -s "${WIN11_ISO}" ] || [ "$(sha256sum "${WIN11_ISO}" | awk '{print $1}')" != "${WIN11_ISO_SHA}" ]; then
    rm -f "${WIN11_ISO}.part"
    curl -fL --retry 3 -C - -o "${WIN11_ISO}.part" "${WIN11_ISO_URL}"
    echo "${WIN11_ISO_SHA}  ${WIN11_ISO}.part" | sha256sum -c -
    mv -f "${WIN11_ISO}.part" "${WIN11_ISO}"
  fi
  echo "${WIN11_ISO_SHA}  ${WIN11_ISO}" | sha256sum -c -

  umount -lf "${TARGET_PART}" 2>/dev/null || true
  mkfs.ntfs -Q -F -L "SR_WIN11_BOOT" "${TARGET_PART}"
  mkdir -p /mnt/sr-win11-part
  mount "${TARGET_PART}" /mnt/sr-win11-part
  7z x -y "${WIN11_ISO}" -o/mnt/sr-win11-part >/dev/null || [ -d /mnt/sr-win11-part/efi ]
  if [ ! -s "/mnt/sr-win11-part/autounattend.xml" ] || ! grep -q "BypassTPMCheck" "/mnt/sr-win11-part/autounattend.xml" 2>/dev/null; then
    cat > "/mnt/sr-win11-part/autounattend.xml" <<'UNATTEND_EOF'
<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassTPMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassSecureBootCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassRAMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassStorageCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>5</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassCPUCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>false</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
    </component>
  </settings>
</unattend>
UNATTEND_EOF
  fi
  sync
  umount /mnt/sr-win11-part

  local PART_UUID
  PART_UUID="$(blkid -s UUID -o value "${TARGET_PART}")"
  # Verify the chainloader target actually exists in what we extracted,
  # before pointing GRUB at it (0xc000000f guard).
  local LOADER="/mnt/sr-win11-part/efi/boot/bootx64.efi"
  if [ ! -f "${LOADER}" ]; then
    # Windows 11 ISOs normally boot via /efi/boot/bootx64.efi or /efi/microsoft/boot/bootmgfw.efi
    if [ -f "/mnt/sr-win11-part/efi/microsoft/boot/bootmgfw.efi" ]; then
      mkdir -p /mnt/sr-win11-part/efi/boot
      cp -f /mnt/sr-win11-part/efi/microsoft/boot/bootmgfw.efi "${LOADER}"
      echo "  (i) bootx64.efi absent; copied bootmgfw.efi in place."
    else
      echo "CRITICAL: no Windows bootloader found in the extracted ISO (efi/boot/bootx64.efi or efi/microsoft/boot/bootmgfw.efi)."
      echo "Refusing to add a GRUB entry that chainloads nothing (this bricks boot). Nothing changed."
      umount /mnt/sr-win11-part 2>/dev/null || true
      return 1
    fi
  fi

  # Write the menu entry against the REAL /boot only.
  # From a live session /etc/grub.d is overlay tmpfs: update-grub there edits nothing persistent.
  if [ ! -d "/boot/grub" ] || mountpoint -q /run/live || mountpoint -q /run/casper 2>/dev/null; then
    echo "CRITICAL: this appears to be a LIVE session (no real /boot/grub on disk)."
    echo "grub-add-win11 must run from an INSTALLED StormRaven/Ubuntu system, not the live ISO."
    echo "Boot the installed OS first, then re-run. Nothing was changed."
    umount /mnt/sr-win11-part 2>/dev/null || true
    return 1
  fi

  cp -f /etc/grub.d/40_custom /etc/grub.d/40_custom.bak.$(date +%s) 2>/dev/null || true
  cat > /etc/grub.d/40_custom <<GRUB40
#!/bin/sh
exec tail -n +3 \$0
menuentry "StormRaven OS — Custom Windows 11 (25H2) Ymir Edition" {
    insmod part_gpt
    insmod part_msdos
    insmod ntfs
    search --no-floppy --fs-uuid --set=root ${PART_UUID}
    chainloader /efi/boot/bootx64.efi
}
GRUB40
  chmod +x /etc/grub.d/40_custom
  sed -i 's/^#*GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub 2>/dev/null || echo "GRUB_DISABLE_OS_PROBER=false" >> /etc/default/grub
  update-grub

  # Post-run sanity: every UUID in the generated config must exist.
  if ! verify_uuids_in_cfg /boot/grub/grub.cfg; then
    echo "Fixing: regenerating grub config once, then re-verifying..."
    update-grub
    verify_uuids_in_cfg /boot/grub/grub.cfg || {
      echo "STILL BROKEN - restoring backup..."
      return 1
    }
  fi

  echo "======================================================================="
  echo " ✦ INTERNAL DUAL-BOOT CONFIGURED ON ${TARGET_PART}!"
  echo "   Reboot your HP to pick between StormRaven Ubuntu 26.04 and"
  echo "   StormRaven Custom Windows 11 (25H2) right from the GRUB menu."
  echo "======================================================================="
}

case "${1:-list}" in
  ventoy)
    shift || true
    if [ -x /usr/local/bin/make-ventoy-usb.sh ]; then
      exec sudo /usr/local/bin/make-ventoy-usb.sh "$@"
    else
      TMP_VTOY="$(mktemp /tmp/make-ventoy-usb.XXXXXX.sh)"
      curl -fsSL "https://01a11428-2aab-7e12-9d89-3543f658a191.skydive.app/make-ventoy-usb.sh" -o "${TMP_VTOY}"
      curl -fsSL "https://01a11428-2aab-7e12-9d89-3543f658a191.skydive.app/make-ventoy-usb.sh.sha256" -o "${TMP_VTOY}.sha256"
      sed -i "s|make-ventoy-usb.sh|${TMP_VTOY}|g" "${TMP_VTOY}.sha256"
      sha256sum -c "${TMP_VTOY}.sha256"
      chmod +x "${TMP_VTOY}"
      exec sudo "${TMP_VTOY}" "$@"
    fi
    ;;
  grub-verify|verify)
    grub_verify
    ;;
  --verify-mode|verify-mode)
    verify_mode_select
    ;;
  list|disks|status)
    list_disks
    ;;
  usb|flash)
    build_dualboot_usb "${2:-}"
    ;;
  disk-part|internal|grub-add-win11)
    stage_internal_dualboot "${2:-}"
    ;;
  *)
    list_disks
    ;;
esac
