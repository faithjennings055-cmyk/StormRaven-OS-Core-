# Better Auth Configuration
# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here

# Set to your deployment URL (production) or http://localhost:3000 (dev)
BETTER_AUTH_URL=http://localhost:3000

# Database connection string (PostgreSQL)
# Example: postgresql://user:password@localhost:5432/stormraven_alfheim
DATABASE_URL=

# Optional: Additional Better Auth configuration
# See https://www.better-auth.com/docs for more options
