// --- DRAGGABLE WINDOW COMPONENT ---
const Window = ({ app, onClose, onFocus, zIndex, initialX, initialY }) => {
  const [pos, setPos] = useState({ x: initialX, y: initialY });
  const [isDragging, setIsDragging] = useState(false);
  const dragRef = useRef(null);

  const handlePointerDown = (e) => {
    onFocus();
    if (e.target.closest('.window-controls')) return;
    setIsDragging(true);
    dragRef.current = { startX: e.clientX, startY: e.clientY, initialX: pos.x, initialY: pos.y };
    e.target.setPointerCapture(e.pointerId);
  };

  const handlePointerMove = (e) => {
    if (!isDragging || !dragRef.current) return;
    setPos({
      x: dragRef.current.initialX + (e.clientX - dragRef.current.startX),
      y: dragRef.current.initialY + (e.clientY - dragRef.current.startY)
    });
  };

  const handlePointerUp = (e) => {
    setIsDragging(false);
    e.target.releasePointerCapture(e.pointerId);
  };

  // Simple Markdown-style parser for rendering
  const renderContent = (text) => {
    return text.split('\n').map((line, index) => {
      if (line.startsWith('###')) {
        return <h3 key={index} className="text-fuchsia-400 font-bold mt-4 mb-2 tracking-widest uppercase">{line.replace('### ', '')}</h3>;
      }
      if (line.startsWith('*')) {
        return <li key={index} className="ml-4 text-gray-300 mb-1 list-disc font-mono text-[11px]">{line.replace('* ', '')}</li>;
      }
      if (line.trim() === '') return <br key={index} />;
      return <p key={index} className="text-gray-300 font-mono text-xs">{line}</p>;
    });
  };

  return (
    <div 
      className="absolute flex flex-col bg-black/90 border border-fuchsia-900/50 rounded-lg shadow-[0_0_30px_rgba(139,92,246,0.15)] overflow-hidden backdrop-blur-xl transition-shadow focus-within:shadow-[0_0_40px_rgba(139,92,246,0.3)]"
      style={{ left: pos.x, top: pos.y, width: 450, height: 350, zIndex, boxShadow: isDragging ? '0 0 50px rgba(139,92,246,0.4)' : undefined }}
      onClick={onFocus}
    >
      <div 
        className="flex items-center justify-between px-3 py-2 bg-gradient-to-r from-fuchsia-950/80 to-black border-b border-fuchsia-900/80 cursor-move select-none"
        onPointerDown={handlePointerDown} onPointerMove={handlePointerMove} onPointerUp={handlePointerUp} onPointerCancel={handlePointerUp}
      >
        <div className="flex items-center space-x-2 pointer-events-none">
          <app.icon className={`w-4 h-4 ${app.color}`} />
          <span className="text-xs font-black tracking-widest text-fuchsia-200 uppercase">{app.title}</span>
        </div>
        <div className="flex space-x-2 window-controls">
          <button className="text-gray-500 hover:text-white transition-colors"><Minus className="w-3 h-3" /></button>
          <button className="text-gray-500 hover:text-white transition-colors"><Square className="w-3 h-3" /></button>
          <button className="text-gray-500 hover:text-red-500 transition-colors" onClick={(e) => { e.stopPropagation(); onClose(); }}><X className="w-3 h-3" /></button>
        </div>
      </div>
      <div className="flex-1 overflow-y-auto bg-[#0a000a] p-5 relative flex flex-col">
        <div className="absolute inset-0 pointer-events-none bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.03),rgba(0,255,0,0.01),rgba(0,0,255,0.03))] bg-[length:100%_4px,3px_100%] opacity-20 z-50"></div>
        <ul className="relative z-10">
          {renderContent(app.content)}
        </ul>
      </div>
    </div>
  );
};

