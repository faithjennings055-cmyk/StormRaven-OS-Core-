[Unit]
Description=StormRaven OS Kernel + Bifrost Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stormraven
ExecStart=/opt/stormraven/StormRaven.Kernel
Environment=STORMRAVEN_DB=/var/lib/stormraven/kernel.db
Environment=STORMRAVEN_GATEWAY_PORT=8787
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
