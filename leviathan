                className={`flex items-center space-x-2 px-4 py-2 rounded-lg cursor-pointer transition-all ${focusedId === win.id ? 'bg-fuchsia-950/80 border border-fuchsia-500/60 text-fuchsia-100 shadow-[inset_0_0_15px_rgba(217,70,239,0.4)]' : 'bg-gray-900/60 border border-gray-800 text-gray-400 hover:bg-gray-800 hover:text-gray-200'}`}
              >
                <win.app.icon className="w-4 h-4" />
                <span className="text-[11px] font-black tracking-widest font-mono truncate hidden sm:block uppercase drop-shadow-sm">{win.app.title.split(' ')[0]}</span>
              </div>
            ))}
          </div>
        </div>

        <div className="flex items-center space-x-6 text-[10px] md:text-xs font-mono font-bold tracking-widest text-fuchsia-400/80 relative z-10">
          <div className="hidden lg:flex items-center text-purple-400"><BrainCircuit className="w-4 h-4 mr-2 animate-pulse" /> NEURAL LINK STABLE</div>
          <div className="flex items-center text-emerald-500"><Activity className="w-4 h-4 mr-2" /> ROOT SECURE</div>
          <div className="text-gray-400 pl-6 border-l border-gray-800">{new Date().toLocaleTimeString()}</div>
        </div>
      </div>
    </div>
  );
}

