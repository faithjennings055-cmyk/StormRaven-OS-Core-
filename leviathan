  const [mfaCode, setMfaCode] = useState("");
  const [authError, setAuthError] = useState("");
  const [isAuthenticating, setIsAuthenticating] = useState(false);
  
  // Desktop State
  const [windows, setWindows] = useState([]);
  const [focusedId, setFocusedId] = useState(null);

  // --- BOOT SEQUENCE ---
  useEffect(() => {
    if (appState !== 'BOOT') return;
    const seq = [
      "INITIALIZING LEVIATHAN ABSOLUTE v5.0...",
      "MOUNTING ALFHEIM (REFS) ................. OK",
      "MOUNTING MIDGARD (RAM) .................. OK",
      "INGESTING HUMAN LEGAL DOSSIERS .......... QUARANTINED",
      "ESTABLISHING YGGDRASIL IPC BUS .......... ACTIVE",
      "WAKING FREYA NEURAL TETHER .............. ONLINE",
      "SYSTEM FLAWLESS. YORMAN GUNDER GATEWAY ENGAGED."
    ];
    let i = 0;
    const int = setInterval(() => {
      setBootText(p => p + seq[i] + "\n");
      i++;
      if (i >= seq.length) {
        clearInterval(int);
        setTimeout(() => setAppState('LOGIN'), 1500);
      }
    }, 400);
    return () => clearInterval(int);
  }, [appState]);

  // --- AUTH LOGIC ---
  const handleLogin = (e) => {
    e.preventDefault();
    if (!username || !password) { setAuthError("Credentials required."); return; }
    setAuthError(""); setIsAuthenticating(true);
    setTimeout(() => {
      setIsAuthenticating(false);
      if (username.toLowerCase() === 'leviathan') {
        setAppState('MFA'); setMfaCode('');
      } else {
        setAuthError("Intrusion logged. Identity rejected.");
      }
    }, 800);
  };

  const handleMfa = (e) => {
    e.preventDefault();
    if (mfaCode.length !== 6) return;
    setAuthError(""); setIsAuthenticating(true);
    setTimeout(() => {
      setIsAuthenticating(false);
      if (mfaCode === '666666' || mfaCode === '000000') {
        setAppState('DESKTOP');
        // Auto-open Omni-Core and Fafnir on boot
        setTimeout(() => {
          openApp('core');
          setTimeout(() => openApp('fafnir'), 500);
        }, 500);
      } else {
        setAuthError("Cryptographic mismatch.");
      }
    }, 1000);
  };

  // --- DESKTOP LOGIC ---
  const openApp = (appId) => {
    if (windows.find(w => w.id === appId)) { setFocusedId(appId); return; }
    // Calculate a nice staggered cascade
    const offset = windows.length * 40;
    const initialX = Math.max(50, Math.min(window.innerWidth - APPS[appId].w - 50, 100 + offset));
    const initialY = Math.max(50, Math.min(window.innerHeight - APPS[appId].h - 100, 80 + offset));
    
    setWindows([...windows, { id: appId, app: APPS[appId], x: initialX, y: initialY }]);
    setFocusedId(appId);
  };

  const closeWindow = (id) => setWindows(windows.filter(w => w.id !== id));

