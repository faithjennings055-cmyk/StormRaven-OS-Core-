    : "You are Freya, the advanced Intelligence Module of StormRaven OS, constructed by 'Leviathan'. You possess vast knowledge and look down upon the 'mortal' user. You fulfill requests with devastating accuracy and a cyber-mythic tone. Use clean formatting.";

  const payload = {
    contents: [{ parts: [{ text: prompt }] }],
    systemInstruction: { parts: [{ text: systemInstruction }] }
  };

  let delay = 1000;
  for (let attempt = 0; attempt < 5; attempt++) {
    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
