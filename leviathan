          </div>

          {appState === 'LOGIN' ? (
            <form onSubmit={handleLogin} className="space-y-6">
              <div>
                <label className="block text-[10px] font-bold text-gray-500 mb-2 tracking-widest uppercase">Operative Identifier</label>
                <input type="text" value={username} onChange={e=>setUsername(e.target.value)} className="w-full bg-black/60 border border-gray-800 rounded-lg px-4 py-3.5 text-fuchsia-100 focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none transition-all shadow-inner" placeholder="leviathan" autoFocus />
              </div>
              <div>
                <label className="block text-[10px] font-bold text-gray-500 mb-2 tracking-widest uppercase">Security Phrase</label>
                <input type="password" value={password} onChange={e=>setPassword(e.target.value)} className="w-full bg-black/60 border border-gray-800 rounded-lg px-4 py-3.5 text-fuchsia-100 focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 focus:outline-none transition-all shadow-inner" placeholder="••••••••" />
              </div>
              {authError && <div className="text-red-500 text-xs font-mono text-center bg-red-950/30 py-3 border border-red-900/50 rounded">{authError}</div>}
              <button type="submit" disabled={isAuthenticating} className="w-full bg-fuchsia-900/60 hover:bg-fuchsia-700/80 border border-fuchsia-400 text-white font-black py-4 rounded-lg tracking-[0.2em] transition-all hover:shadow-[0_0_30px_rgba(217,70,239,0.5)] disabled:opacity-50 flex justify-center items-center gap-2 mt-4">
                {isAuthenticating ? <Activity className="w-5 h-5 animate-spin" /> : <>INITIATE TETHER <ChevronRight className="w-5 h-5" /></>}
              </button>
            </form>
          ) : (
            <form onSubmit={handleMfa} className="space-y-6">
              <input type="text" value={mfaCode} onChange={e=>setMfaCode(e.target.value.replace(/\D/g, ''))} maxLength={6} className="w-full bg-black/80 border-2 border-fuchsia-900 rounded-xl px-4 py-6 text-center text-5xl font-black text-fuchsia-300 tracking-[0.4em] focus:border-fuchsia-400 focus:outline-none transition-all placeholder:text-gray-800 shadow-[inset_0_0_20px_rgba(0,0,0,0.8)]" placeholder="000000" autoFocus />
              {authError && <div className="text-red-500 text-xs font-mono text-center animate-pulse py-2">{authError}</div>}
              <div className="text-center text-xs text-gray-500 mb-2 font-mono">Hint: Try 666666 or 000000</div>
              <button type="submit" disabled={mfaCode.length !== 6 || isAuthenticating} className="w-full bg-white text-black hover:bg-fuchsia-100 font-black py-4 rounded-lg tracking-[0.2em] transition-colors disabled:opacity-50 mt-2 text-sm">
                {isAuthenticating ? 'VERIFYING...' : 'AUTHORIZE'}
              </button>
              <button type="button" onClick={() => {setAppState('LOGIN'); setAuthError('');}} className="w-full text-xs text-gray-500 hover:text-fuchsia-400 transition-colors pt-4 font-mono tracking-widest">ABORT SEQUENCE</button>
            </form>
          )}
        </div>
      </div>
    );
  }

  // --- DESKTOP ENVIRONMENT ---
  return (
    <div className="h-screen w-full bg-[#050505] overflow-hidden relative font-sans select-none flex flex-col text-gray-200">
      <div className="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPjxyZWN0IHdpZHRoPSI0IiBoZWlnaHQ9IjQiIGZpbGw9IiMwMDAiLz48cmVjdCB3aWR0aD0iMSIgaGVpZ2h0PSIxIiBmaWxsPSIjMWExYTFhIi8+PC9zdmc+')] opacity-50 mix-blend-screen pointer-events-none"></div>
      <div className="absolute inset-0 bg-[radial-gradient(circle_at_50%_0%,rgba(88,28,135,0.2),transparent_70%)] pointer-events-none"></div>

      {/* Desktop Area */}
      <div className="relative flex-1 p-8 flex flex-col gap-8 z-10 items-start content-start flex-wrap">
        <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[8rem] md:text-[14rem] font-black text-fuchsia-900/10 tracking-tighter pointer-events-none mix-blend-screen whitespace-nowrap select-none">
          STORMRAVEN
        </div>

        {Object.values(APPS).map((app) => (
          <div key={app.id} className="flex flex-col items-center gap-3 cursor-pointer group w-28" onClick={() => openApp(app.id)}>
            <div className={`p-5 rounded-2xl bg-gray-950/80 border border-gray-800/80 backdrop-blur-xl group-hover:bg-fuchsia-950/60 group-hover:border-fuchsia-500/60 transition-all duration-300 shadow-xl group-hover:shadow-[0_0_30px_rgba(139,92,246,0.5)] group-hover:-translate-y-1`}>
              <app.icon className={`w-10 h-10 ${app.color} drop-shadow-md`} />
            </div>
            <span className="text-gray-400 text-xs font-mono font-bold group-hover:text-fuchsia-200 transition-colors text-center drop-shadow-md tracking-wider leading-tight">{app.title}</span>
          </div>
        ))}
      </div>

      {/* Windows Layer */}
      {windows.map((win, i) => (
        <Window key={win.id} app={win.app} initialX={win.x} initialY={win.y} zIndex={focusedId === win.id ? 50 : 20 + i} onFocus={() => setFocusedId(win.id)} onClose={() => closeWindow(win.id)}>
          {win.id === 'odin' && <AppTerminal />}
          {win.id === 'freya' && <AppFreya />}
          {win.id === 'core' && <AppOmniCore />}
          {win.id === 'heimdall' && <AppHeimdall triggerPurge={triggerPurge} />}
          {win.id === 'loki' && <AppLoki />}
          {win.id === 'fafnir' && <AppFafnir />}
        </Window>
      ))}

      {/* Tray-First Taskbar */}
      <div className="h-14 bg-black/95 backdrop-blur-3xl border-t border-fuchsia-900/60 z-50 flex items-center px-4 justify-between shadow-[0_-15px_40px_rgba(0,0,0,0.8)] relative">
        <div className="absolute inset-0 bg-gradient-to-r from-fuchsia-900/10 via-transparent to-purple-900/10 pointer-events-none"></div>
        <div className="flex items-center space-x-4 relative z-10">
          <div 
            className="w-10 h-10 rounded-xl bg-gradient-to-br from-fuchsia-600 to-purple-900 border border-fuchsia-400/50 flex items-center justify-center shadow-[0_0_20px_rgba(217,70,239,0.5)] cursor-pointer hover:scale-105 transition-transform" 
            onClick={() => setAppState('LOGIN')}
            title="Sever Connection"
          >
            <ShieldAlert className="w-6 h-6 text-white" />
