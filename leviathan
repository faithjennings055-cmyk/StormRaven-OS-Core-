const Window = ({ app, onClose, onFocus, zIndex, children, initialX, initialY }) => {
  const [pos, setPos] = useState({ x: initialX, y: initialY });
  const [isDragging, setIsDragging] = useState(false);
  const dragRef = useRef(null);

  const handlePointerDown = (e) => {
    onFocus();
    if (e.target.closest('.window-controls') || e.target.tagName.toLowerCase() === 'button' || e.target.tagName.toLowerCase() === 'input') return;
    setIsDragging(true);
    dragRef.current = { startX: e.clientX, startY: e.clientY, initialX: pos.x, initialY: pos.y };
    e.target.setPointerCapture(e.pointerId);
  };

  const handlePointerMove = (e) => {
    if (!isDragging || !dragRef.current) return;
    setPos({
      x: dragRef.current.initialX + (e.clientX - dragRef.current.startX),
      y: dragRef.current.initialY + (e.clientY - dragRef.current.startY)
    });
  };

  const handlePointerUp = (e) => {
    setIsDragging(false);
    e.target.releasePointerCapture(e.pointerId);
  };

  return (
    <div 
      className="absolute flex flex-col bg-black/90 border border-fuchsia-900/50 rounded-lg shadow-[0_0_40px_rgba(139,92,246,0.15)] overflow-hidden backdrop-blur-xl transition-shadow focus-within:shadow-[0_0_50px_rgba(139,92,246,0.4)]"
      style={{ left: pos.x, top: pos.y, width: app.w, height: app.h, zIndex, boxShadow: isDragging ? '0 0 60px rgba(139,92,246,0.5)' : undefined }}
      onClick={onFocus}
    >
      <div 
        className="flex items-center justify-between px-3 py-2 bg-gradient-to-r from-fuchsia-950 to-black border-b border-fuchsia-900/80 cursor-move select-none"
        onPointerDown={handlePointerDown} onPointerMove={handlePointerMove} onPointerUp={handlePointerUp} onPointerCancel={handlePointerUp}
      >
        <div className="flex items-center space-x-2 pointer-events-none">
          <app.icon className={`w-4 h-4 ${app.color}`} />
          <span className="text-xs font-black tracking-widest text-fuchsia-200 uppercase drop-shadow-[0_0_5px_rgba(217,70,239,0.8)]">{app.title}</span>
        </div>
        <div className="flex space-x-2 window-controls">
          <button className="text-gray-500 hover:text-white transition-colors"><Minus className="w-3 h-3" /></button>
          <button className="text-gray-500 hover:text-white transition-colors"><Square className="w-3 h-3" /></button>
          <button className="text-gray-500 hover:text-red-500 transition-colors" onClick={(e) => { e.stopPropagation(); onClose(); }}><X className="w-3 h-3" /></button>
        </div>
      </div>
      <div className="flex-1 overflow-hidden bg-black/80 text-gray-300 font-mono text-sm relative flex flex-col">
        <div className="absolute inset-0 pointer-events-none bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.03),rgba(0,255,0,0.01),rgba(0,0,255,0.03))] bg-[length:100%_4px,3px_100%] opacity-30 z-50"></div>
        {children}
      </div>
    </div>
  );
};

