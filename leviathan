        <div className="h-1 bg-fuchsia-950 w-full mt-6 overflow-hidden rounded z-10"><div className="h-full bg-fuchsia-500 shadow-[0_0_20px_#d946ef] animate-[loading_2.5s_ease-in-out_forwards]" style={{width: '100%'}}/></div>
        <style>{`@keyframes loading { 0% { width: 0%; } 100% { width: 100%; } }`}</style>
      </div>
    );
  }

  if (appState === 'LOGIN' || appState === 'MFA') {
    return (
      <div className="h-screen w-full bg-black flex items-center justify-center font-sans relative overflow-hidden selection:bg-fuchsia-900 selection:text-white">
        <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(88,28,135,0.2),rgba(0,0,0,1)_80%)]"></div>
        <div className="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPjxyZWN0IHdpZHRoPSI0IiBoZWlnaHQ9IjQiIGZpbGw9IiMwMDAiLz48cmVjdCB3aWR0aD0iMSIgaGVpZ2h0PSIxIiBmaWxsPSIjMWExYTFhIi8+PC9zdmc+')] opacity-40"></div>
        
        <div className="z-10 w-full max-w-md bg-gray-950/80 backdrop-blur-2xl border border-fuchsia-900/60 p-10 rounded-2xl shadow-[0_0_80px_rgba(0,0,0,0.9)]">
          <div className="flex flex-col items-center mb-10">
            <div className="w-20 h-20 bg-gradient-to-br from-fuchsia-900 to-black border-2 border-fuchsia-500/50 rounded-xl flex items-center justify-center mb-6 shadow-[0_0_30px_rgba(217,70,239,0.3)]">
              {appState === 'LOGIN' ? <KeyRound className="w-10 h-10 text-fuchsia-400 drop-shadow-lg" /> : <ShieldAlert className="w-10 h-10 text-red-400 drop-shadow-lg" />}
            </div>
            <h1 className="text-2xl font-black text-white tracking-[0.2em] uppercase">{appState === 'LOGIN' ? 'Yorman Gunder' : 'Luci Authorization'}</h1>
