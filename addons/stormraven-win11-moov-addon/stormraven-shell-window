class StormRavenCommandCenter(Gtk.Window):
    def __init__(self):
        super().__init__(title="StormRaven OS: Infinity Protocol v3.9.0 — Ethereal Void Command Center")
        self.set_default_size(980, 640)
        self.set_position(Gtk.WindowPosition.CENTER)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        root.get_style_context().add_class("void-bg")
        self.add(root)

        # Top Header Bar
        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        hdr.get_style_context().add_class("header-bar")
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl_title = Gtk.Label(label="✦ STORMRAVEN OS · INFINITY PROTOCOL v3.9.0 (UBUNTU 24.04 LTS · LINUX 7.0 HWE)")
        lbl_title.set_xalign(0)
        lbl_title.get_style_context().add_class("title-lg")
        self.lbl_sub = Gtk.Label(label="Bifrost Gateway (:8787) ONLINE · Luci Hardware Seal AUTHORIZED · 2011–2026 Firmware Active")
        self.lbl_sub.set_xalign(0)
        self.lbl_sub.get_style_context().add_class("subtitle")
        title_box.pack_start(lbl_title, False, False, 0)
        title_box.pack_start(self.lbl_sub, False, False, 0)
        hdr.pack_start(title_box, True, True, 0)

        badge = Gtk.Label(label="● 9 REALMS ONLINE")
        badge.get_style_context().add_class("status-ok")
        hdr.pack_end(badge, False, False, 8)
        root.pack_start(hdr, False, False, 0)

        # Try or Install Welcome Banner
        banner_wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        banner_wrap.set_margin_top(10)
        banner_wrap.set_margin_start(14)
        banner_wrap.set_margin_end(14)
        banner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        banner.get_style_context().add_class("banner-box")

        b_txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        b_h = Gtk.Label(label="Welcome to the StormRaven OS Boot Disk (Try Live or Install to Disk)")
        b_h.set_xalign(0)
        b_h.set_markup("<b>Welcome to the StormRaven OS v3.9.0 Boot Disk (Try Live or Install to Disk)</b>")
        b_p = Gtk.Label(label="Includes GParted · TestDisk/PhotoRec · ddrescue · LVM2/LUKS/RAID · EFIBootMgr/GRUB · 2011–2026 Drivers")
        b_p.set_xalign(0)
        b_p.get_style_context().add_class("subtitle")
        b_txt.pack_start(b_h, False, False, 0)
        b_txt.pack_start(b_p, False, False, 0)
        banner.pack_start(b_txt, True, True, 0)

        btn_install = Gtk.Button(label="💿 Install StormRaven OS to Disk")
        btn_install.get_style_context().add_class("cta-btn")
        btn_install.connect("clicked", lambda *_: self.spawn_cmd("lxterminal -T 'Install StormRaven OS v3.9.0' -e 'sudo /usr/local/bin/stormraven-installer'"))
        banner.pack_end(btn_install, False, False, 0)

        btn_gparted = Gtk.Button(label="🖴 Open GParted")
        btn_gparted.get_style_context().add_class("sec-btn")
        btn_gparted.connect("clicked", lambda *_: self.spawn_cmd("sudo gparted"))
        banner.pack_end(btn_gparted, False, False, 0)

        banner_wrap.pack_start(banner, False, False, 0)
        root.pack_start(banner_wrap, False, False, 0)

        # Notebook Tabs
        nb = Gtk.Notebook()
        nb.set_margin_top(10)
        nb.set_margin_start(14)
        nb.set_margin_end(14)
        nb.set_margin_bottom(12)
        root.pack_start(nb, True, True, 0)

        # Tab 1: Applications & Rescue Suite Grid
        grid_scroll = Gtk.ScrolledWindow()
        grid_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        grid_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        grid_vbox.set_margin_top(12)
        grid_vbox.set_margin_bottom(12)
        grid_vbox.set_margin_start(12)
        grid_vbox.set_margin_end(12)

        grid = Gtk.Grid()
        grid.set_column_spacing(10)
        grid.set_row_spacing(10)
        grid.set_column_homogeneous(True)

        apps = [
            ("💿 Install StormRaven OS", "lxterminal -T 'StormRaven Installer' -e 'sudo /usr/local/bin/stormraven-installer'"),
            ("🖴 GParted Partitioner", "sudo gparted"),
            ("📁 Fafnir File Explorer", "pcmanfm /home/ubuntu"),
            ("❯_ Odin Pantheon Shell", "lxterminal -T 'Odin Pantheon' -e '/bin/bash -c \"stormraven status; exec /bin/bash -i\"'"),
            ("🛠 Boot Repair & EFI", "lxterminal -T 'Boot Repair & EFI' -e '/bin/bash -c \"sudo efibootmgr -v || true; sudo os-prober || true; lsblk -f; read -p Press_Enter...\"'"),
            ("🛟 TestDisk & PhotoRec", "lxterminal -T 'TestDisk Data Recovery' -e 'sudo testdisk'"),
            ("🧠 Freya Onboard AI", "lxterminal -T 'Freya Onboard AI' -e '/bin/bash -c \"stormraven ai; read -p Press_Enter...\"'"),
            ("🛡 Heimdall Zero-Trust", "lxterminal -T 'Heimdall Security' -e '/bin/bash -c \"stormraven luci status; stormraven baseline-audit; read -p Press_Enter...\"'"),
            ("🔒 WireGuard VPN + KillSwitch", "lxterminal -T 'StormRaven VPN' -e '/bin/bash -c \"stormraven-vpn status; read -p Press_Enter...\"'"),
            ("🖥 KVM / Virtual Machine Mgr", "virt-manager"),
            ("🔍 Forensics Suite", "lxterminal -T 'StormRaven Forensics' -e '/bin/bash -c \"stormraven-forensics status; read -p Press_Enter...\"'"),
            ("📈 Htop System Monitor", "lxterminal -T 'Htop Monitor' -e 'htop'"),
            ("🧩 2011–2026 Hardware Info", "lxterminal -T 'Hardware Inspector' -e '/bin/bash -c \"inxi -Fxz || lshw -short; read -p Press_Enter...\"'"),
            ("🖴 NVMe & SMART Health", "lxterminal -T 'Drive SMART Health' -e '/bin/bash -c \"sudo nvme list || true; lsblk -o NAME,SIZE,MODEL,FSTYPE,MOUNTPOINT; read -p Press_Enter...\"'"),
            ("🌐 Web Browser (NetSurf)", "netsurf-gtk http://127.0.0.1:3887/"),
            ("⏱ Timeshift Snapshots", "lxterminal -T 'Timeshift Restore' -e '/bin/bash -c \"sudo timeshift --list || true; read -p Press_Enter...\"'"),
        ]

        for idx, (label, cmd) in enumerate(apps):
            btn = Gtk.Button(label=label)
            btn.get_style_context().add_class("app-btn")
            btn.connect("clicked", lambda _b, c=cmd: self.spawn_cmd(c))
            grid.attach(btn, idx % 4, idx // 4, 1, 1)

        grid_vbox.pack_start(grid, False, False, 0)

        # Live Telemetry & Console Output Box
        out_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        out_card.get_style_context().add_class("card-box")
        out_hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        out_lbl = Gtk.Label(label="Live Kernel, Nine Realms & Odin Pantheon Telemetry (:8787)")
        out_lbl.set_xalign(0)
        out_hdr.pack_start(out_lbl, True, True, 0)

        for act_label, act_cmd in [
            ("⚡ Refresh Telemetry", "telemetry"),
            ("🌌 Nine Realms", "realms"),
            ("🛡 Baseline Audit", "audit"),
            ("💿 Disks & Rescue Tools", "installer"),
        ]:
            b = Gtk.Button(label=act_label)
            b.get_style_context().add_class("sec-btn")
            b.connect("clicked", lambda _b, a=act_cmd: self.run_Quick_action(a))
            out_hdr.pack_end(b, False, False, 0)

        out_card.pack_start(out_hdr, False, False, 0)

        self.txt_view = Gtk.TextView()
        self.txt_view.set_editable(False)
        self.txt_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.txt_buf = self.txt_view.get_buffer()
        txt_scroll = Gtk.ScrolledWindow()
        txt_scroll.set_min_content_height(175)
        txt_scroll.add(self.txt_view)
        out_card.pack_start(txt_scroll, True, True, 0)

        grid_vbox.pack_start(out_card, True, True, 0)
        grid_scroll.add(grid_vbox)
        nb.append_page(grid_scroll, Gtk.Label(label="✦ Applications, Installer & Rescue Suite"))

        # Initial telemetry load
        self.run_Quick_action("telemetry")

    def spawn_cmd(self, cmd):
        subprocess.Popen(["/bin/bash", "-c", cmd], start_new_session=True)

    def run_Quick_action(self, action):
        def worker():
            try:
                if action == "realms":
                    out = subprocess.check_output(["/usr/local/bin/stormraven", "realms"], text=True, timeout=4)
                elif action == "audit":
                    out = subprocess.check_output(["/usr/local/bin/stormraven", "baseline-audit"], text=True, timeout=4)
                elif action == "installer":
                    out = subprocess.check_output(["/usr/local/bin/stormraven-installer", "--status-json"], text=True, timeout=4)
                else:
                    with urllib.request.urlopen("http://127.0.0.1:8787/health", timeout=2) as r:
                        data = json.loads(r.read().decode())
                    out = json.dumps(data.get("data", data), indent=2)
            except Exception as exc:
                out = f"StormRaven OS v3.9.0 Live Kernel Status: ONLINE\n({exc})"
            GLib.idle_add(self.txt_buf.set_text, out)

        threading.Thread(target=worker, daemon=True).start()


if __name__ == "__main__":
    win = StormRavenCommandCenter()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
