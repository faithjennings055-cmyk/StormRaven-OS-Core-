<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>
  <!-- Bifrost Gateway reads the storage schema at startup; ship it with the build. -->
  <ItemGroup>
    <None Include="Storage/Schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The nested StormRavenOS/ folder is a stray duplicate of this project's
       sources; exclude it so its types don't collide with the real ones. -->
  <ItemGroup>
    <Compile Remove="StormRavenOS/**" />
    <!-- StormRaven.Mobile is a separate MAUI app; it is not compiled with the kernel
         (requires the MAUI workload). Exclude its sources from the kernel build. -->
    <Compile Remove="StormRaven.Mobile/**" />
    <Compile Remove="obj/**" />
  </ItemGroup>
</Project>