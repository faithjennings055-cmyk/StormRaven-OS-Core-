const triggerHaptic = (pattern = 50) => {
  if (typeof navigator !== 'undefined' && navigator.vibrate) {
    navigator.vibrate(pattern);
  }
};

const callGemini = async (prompt, systemInstructionText = "") => {
  const apiKey = ""; 
  const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;

  const sysInst = systemInstructionText || "You are an advanced Intelligence Module of StormRaven OS. Fulfill requests with devastating accuracy and a cold, cyber-mythic tone.";

  const payload = {
    contents: [{ parts: [{ text: prompt }] }],
    systemInstruction: { parts: [{ text: sysInst }] }
  };

  let delay = 1000;
  for (let attempt = 0; attempt < 5; attempt++) {
    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
      const result = await response.json();
      return result.candidates?.[0]?.content?.parts?.[0]?.text || "Silence from the void.";
    } catch (error) {
      if (attempt === 4) return `[SYSTEM FAULT] The tether dropped. Your mobile bandwidth is insufficient.`;
      await new Promise(res => setTimeout(res, delay));
      delay *= 2;
    }
  }
};

