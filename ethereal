const MobileWindow = ({ app, onClose, children }) => {
  const [startY, setStartY] = useState(null);
  const [currentY, setCurrentY] = useState(0);
  const [isClosing, setIsClosing] = useState(false);

  const handleTouchStart = (e) => {
    setStartY(e.touches[0].clientY);
  };

  const handleTouchMove = (e) => {
    if (!startY) return;
    const y = e.touches[0].clientY;
    const delta = y - startY;
    if (delta > 0) { // Only allow swiping downwards
      setCurrentY(delta);
    }
  };

  const handleTouchEnd = () => {
    if (currentY > 150) {
      triggerHaptic([50, 50]);
      setIsClosing(true);
      setTimeout(onClose, 300); // Wait for animation
    } else {
      setCurrentY(0); // Snap back
    }
    setStartY(null);
  };

  return (
    <div 
      className={`absolute inset-x-0 bottom-0 top-[env(safe-area-inset-top,40px)] bg-black/95 z-40 flex flex-col rounded-t-3xl border-t border-x border-fuchsia-900/50 shadow-[0_-10px_50px_rgba(139,92,246,0.2)] transition-transform duration-300 backdrop-blur-2xl ${isClosing ? 'translate-y-full' : 'translate-y-0 animate-slide-up'}`}
      style={{ transform: !isClosing && currentY > 0 ? `translateY(${currentY}px)` : undefined }}
    >
      {/* Gesture Handle */}
      <div 
        className="w-full pt-4 pb-2 flex justify-center items-center cursor-grab active:cursor-grabbing touch-none"
        onTouchStart={handleTouchStart}
        onTouchMove={handleTouchMove}
        onTouchEnd={handleTouchEnd}
      >
        <div className="w-16 h-1.5 bg-gray-700 rounded-full" />
      </div>

      {/* Header */}
      <div className="flex items-center justify-between px-6 py-2 pb-4">
        <div className="flex items-center space-x-3">
          <div className={`p-2 rounded-lg bg-gray-900/50 border border-gray-800 ${app.color}`}>
            <app.icon className="w-5 h-5" />
          </div>
          <div>
            <h2 className="text-sm font-black tracking-widest text-fuchsia-100 uppercase">{app.title}</h2>
            <p className="text-[10px] text-gray-500 font-mono tracking-widest uppercase">Active Daemon</p>
          </div>
        </div>
      </div>

      {/* Content */}
      <div className="flex-1 overflow-hidden relative bg-black/80 text-gray-300 font-mono text-sm flex flex-col rounded-t-3xl">
        <div className="absolute inset-0 pointer-events-none bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%)] bg-[length:100%_4px] opacity-20 z-50"></div>
        {children}
      </div>
    </div>
  );
};

