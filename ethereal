const AppTerminal = () => {
  const [logs, setLogs] = useState(["LEVIATHAN MOBILE SHELL ONLINE.", "Awaiting biometric or physical input..."]);
  const [input, setInput] = useState('');
  const bottomRef = useRef(null);

  const handleSend = async () => {
    if (!input.trim()) return;
    triggerHaptic();
    const cmd = input.trim();
    setLogs(p => [...p, `root@stormraven:~# ${cmd}`]);
    setInput('');

    if (cmd.toLowerCase().startsWith('freya ')) {
      const resp = await callGemini(cmd.substring(6), "You are the Odin Terminal of StormRaven OS. Respond with extreme machine brevity. Raw text only.");
      setLogs(p => [...p, `[FREYA] ${resp}`]);
      triggerHaptic([30, 50, 30]);
    } else {
      setLogs(p => [...p, `Command logged to Midgard RAM.`]);
    }
  };

  return (
    <div className="flex flex-col h-full p-4">
      <div className="flex-1 overflow-y-auto space-y-2 text-xs pb-4">
        {logs.map((l, i) => <div key={i} className="text-fuchsia-400 break-words">{l}</div>)}
        <div ref={bottomRef} />
      </div>
      <div className="flex bg-gray-950/80 border border-fuchsia-900/50 rounded-2xl items-center p-1 mb-[env(safe-area-inset-bottom,10px)]">
